@{
    Layout = null; // Esto le dice a ASP.NET que no use _Layout.cshtml
}

<!DOCTYPE html>
<html lang="es">
</html>
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SENA PAY — Gestión institucional sin filas</title>
    <style>
        /* ── Variables dark (default) ── */
        :root {
          --color-bg:        #1A1A1A;
          --color-surface:   #222222;
          --color-border:    #2e2e2e;
          --color-green:     #39A900;
          --color-green-dim: #2d8600;
          --color-white:     #FFFFFF;
          --color-muted:     #888888;
          --color-shimmer-a: #ffffff18;
          --color-shimmer-b: #ffffff40;
          --color-subtitle-strong: #cccccc;

          --font-sans: 'Inter', 'Segoe UI', sans-serif;
          --radius-sm: 6px;
          --radius-md: 12px;
          --radius-pill: 999px;
          --transition: 200ms ease;
        }

        /* ── Variables light ── */
        :root.light {
          --color-bg:        #F4F6F3;
          --color-surface:   #FFFFFF;
          --color-border:    #d4d9d0;
          --color-green:     #2e8a00;
          --color-green-dim: #236b00;
          --color-white:     #111111;
          --color-muted:     #666666;
          --color-shimmer-a: #00000010;
          --color-shimmer-b: #00000025;
          --color-subtitle-strong: #333333;
        }

        /* smooth all color transitions on theme switch */
        html { transition: background 300ms ease, color 300ms ease; }
        *, *::before, *::after { transition: background-color 300ms ease, border-color 300ms ease, color 300ms ease, box-shadow 300ms ease; }

        /* ── Theme toggle button ── */
        .theme-toggle {
          width: 36px;
          height: 36px;
          border-radius: 50%;
          border: 1px solid var(--color-border);
          background: transparent;
          color: var(--color-muted);
          cursor: pointer;
          display: flex;
          align-items: center;
          justify-content: center;
          font-size: 16px;
          flex-shrink: 0;
          transition: background 200ms, border-color 200ms, transform 200ms;
        }
        .theme-toggle:hover {
          background: var(--color-surface);
          border-color: var(--color-green);
          color: var(--color-green);
          transform: rotate(20deg);
        }
        .theme-toggle .icon-moon { display: block; }
        .theme-toggle .icon-sun  { display: none; }
        :root.light .theme-toggle .icon-moon { display: none; }
        :root.light .theme-toggle .icon-sun  { display: block; }

        /* ── Reset ── */
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        html, body {
          height: 100%;
          background: var(--color-bg);
          color: var(--color-white);
          font-family: var(--font-sans);
          -webkit-font-smoothing: antialiased;
        }

        /* ── Layout ── */
        .page {
          min-height: 100vh;
          display: grid;
          grid-template-rows: auto 1fr auto;
        }

        /* ── Background film reel logo ── */
        .bg-logo {
          position: fixed;
          inset: 0;
          display: flex;
          flex-direction: column;
          justify-content: center;
          pointer-events: none;
          z-index: 0;
          overflow: hidden;
          gap: 0;
        }

        /* scrolling text track */
        .bg-logo-track {
          display: flex;
          align-items: center;
          gap: 80px;
          white-space: nowrap;
          animation: film-scroll 14s linear infinite;
          flex: 1;
          padding: 8px 0;
        }
        .bg-logo-item {
          font-size: clamp(90px, 15vw, 180px);
          font-weight: 900;
          letter-spacing: -5px;
          color: transparent;
          -webkit-text-stroke: 2px #39ff6a;
          filter: drop-shadow(0 0 8px #39ff6a99) drop-shadow(0 0 22px #39A90066);
          user-select: none;
          flex-shrink: 0;
          transition: -webkit-text-stroke 300ms, filter 300ms;
        }
        .bg-logo-item span { -webkit-text-stroke-color: #a0ffb0; }
        :root.light .bg-logo-item { -webkit-text-stroke: 2px rgba(46,138,0,0.22); filter: none; }
        :root.light .bg-logo-item span { -webkit-text-stroke-color: rgba(46,138,0,0.38); }

        /* separator reel mark between words */
        .film-mark {
          font-size: 60px;
          color: transparent;
          -webkit-text-stroke: 1.5px #39ff6a44;
          flex-shrink: 0;
          transition: -webkit-text-stroke 300ms;
        }
        :root.light .film-mark { -webkit-text-stroke-color: rgba(46,138,0,0.14); }

        @@keyframes film-scroll {
          0%   { transform: translateX(0); }
          100% { transform: translateX(-50%); }
        }

        /* ── Header ── */
        header {
          position: relative;
          z-index: 10;
          padding: 1.5rem 2rem;
          display: flex;
          align-items: center;
          justify-content: space-between;
          border-bottom: 1px solid var(--color-border);
        }

        .logo {
          display: flex;
          align-items: center;
          gap: 10px;
          text-decoration: none;
        }

        .logo-mark {
          width: 32px;
          height: 32px;
          background: var(--color-green);
          border-radius: var(--radius-sm);
          display: flex;
          align-items: center;
          justify-content: center;
          font-size: 11px;
          font-weight: 800;
          color: #fff;
          letter-spacing: -0.5px;
          position: relative;
          overflow: hidden;
        }

        /* Shimmer on logo mark */
        .logo-mark::after {
          content: '';
          position: absolute;
          top: 0; left: -100%;
          width: 60%;
          height: 100%;
          background: linear-gradient(90deg, transparent, var(--color-shimmer-b), transparent);
          animation: shimmer 2.8s ease-in-out infinite;
        }

        @@keyframes shimmer {
          0%   { left: -100%; opacity: 0; }
          20%  { opacity: 1; }
          60%  { left: 140%; opacity: 1; }
          61%  { opacity: 0; }
          100% { left: 140%; opacity: 0; }
        }

        .logo-text {
          font-size: 15px;
          font-weight: 700;
          color: var(--color-white);
          letter-spacing: 0.5px;
          position: relative;
          overflow: hidden;
        }

        /* Shimmer on logo text */
        .logo-text::after {
          content: '';
          position: absolute;
          top: 0; left: -100%;
          width: 50%;
          height: 100%;
          background: linear-gradient(90deg, transparent, var(--color-shimmer-a), transparent);
          animation: shimmer 2.8s ease-in-out 0.3s infinite;
        }

        .logo-text span { color: var(--color-green); }

        .header-pill {
          font-size: 11px;
          color: var(--color-muted);
          border: 1px solid var(--color-border);
          padding: 4px 10px;
          border-radius: var(--radius-pill);
          letter-spacing: 0.5px;
        }

        /* ── Hero ── */
        main {
          position: relative;
          z-index: 1;
          display: flex;
          flex-direction: column;
          align-items: center;
          justify-content: center;
          text-align: center;
          padding: 4rem 1.5rem;
          gap: 0;
        }

        /* Radial glow behind hero */
        main::before {
          content: '';
          position: absolute;
          top: 0; left: 50%;
          transform: translateX(-50%);
          width: 600px;
          height: 400px;
          background: radial-gradient(ellipse at center top, #39A90018 0%, transparent 70%);
          pointer-events: none;
        }

        .eyebrow {
          display: inline-flex;
          align-items: center;
          gap: 6px;
          font-size: 11px;
          font-weight: 600;
          letter-spacing: 1.5px;
          text-transform: uppercase;
          color: var(--color-green);
          border: 1px solid #39A90035;
          background: #39A90010;
          padding: 5px 14px;
          border-radius: var(--radius-pill);
          margin-bottom: 2rem;
        }

        .eyebrow-dot {
          width: 6px;
          height: 6px;
          background: var(--color-green);
          border-radius: 50%;
          animation: pulse-dot 2s ease-in-out infinite;
        }

        @@keyframes pulse-dot {
          0%, 100% { opacity: 1; transform: scale(1); }
          50%       { opacity: 0.4; transform: scale(0.7); }
        }

        h1 {
          font-size: clamp(2rem, 5vw, 3.6rem);
          font-weight: 800;
          line-height: 1.1;
          letter-spacing: -1.5px;
          color: var(--color-white);
          max-width: 720px;
          margin-bottom: 1.5rem;
        }

        h1 em {
          font-style: normal;
          color: var(--color-green);
        }

        .subtitle {
          font-size: clamp(0.95rem, 2vw, 1.1rem);
          color: var(--color-muted);
          line-height: 1.75;
          max-width: 520px;
          margin-bottom: 3rem;
        }

        .subtitle strong {
          color: var(--color-subtitle-strong);
          font-weight: 500;
        }

        /* ── CTA Button ── */
        .cta-wrapper {
          display: flex;
          flex-direction: column;
          align-items: center;
          gap: 1rem;
        }

        .btn-primary {
          display: inline-flex;
          align-items: center;
          gap: 10px;
          background: var(--color-green);
          color: #fff;
          font-size: 15px;
          font-weight: 700;
          letter-spacing: 0.2px;
          text-decoration: none;
          padding: 14px 32px;
          border-radius: var(--radius-pill);
          border: none;
          cursor: pointer;
          position: relative;
          overflow: hidden;
          transition: background var(--transition), transform var(--transition), box-shadow var(--transition);
          box-shadow: 0 0 0 0 #39A90040;
        }

        .btn-primary::before {
          content: '';
          position: absolute;
          inset: 0;
          background: linear-gradient(135deg, #ffffff22 0%, transparent 50%);
          border-radius: inherit;
        }

        .btn-primary:hover {
          background: var(--color-green-dim);
          transform: translateY(-2px);
          box-shadow: 0 8px 24px #39A90050;
        }

        .btn-primary:active {
          transform: translateY(0);
          box-shadow: none;
        }

        /* Arrow icon */
        .btn-arrow {
          width: 18px;
          height: 18px;
          border-radius: 50%;
          background: rgba(255,255,255,0.2);
          display: flex;
          align-items: center;
          justify-content: center;
          font-size: 11px;
          transition: transform var(--transition);
        }

        .btn-primary:hover .btn-arrow {
          transform: translateX(3px);
        }

        .cta-note {
          font-size: 12px;
          color: var(--color-muted);
          display: flex;
          align-items: center;
          gap: 5px;
        }

        .cta-note::before {
          content: '';
          display: inline-block;
          width: 8px;
          height: 8px;
          background: var(--color-green);
          border-radius: 50%;
          opacity: 0.7;
        }

        /* ── Stats strip ── */
        .stats {
          position: relative;
          z-index: 1;
          display: flex;
          justify-content: center;
          gap: 0;
          border-top: 1px solid var(--color-border);
          margin-top: auto;
        }

        .stat-item {
          flex: 1;
          max-width: 220px;
          padding: 1.5rem 1rem;
          text-align: center;
          border-right: 1px solid var(--color-border);
        }

        .stat-item:last-child { border-right: none; }

        .stat-number {
          font-size: 22px;
          font-weight: 800;
          color: var(--color-white);
          letter-spacing: -0.5px;
        }

        .stat-number span { color: var(--color-green); }

        .stat-label {
          font-size: 11px;
          color: var(--color-muted);
          margin-top: 3px;
          letter-spacing: 0.3px;
        }

        /* ── Footer ── */
        footer {
          position: relative;
          z-index: 1;
          padding: 1rem 2rem;
          border-top: 1px solid var(--color-border);
          display: flex;
          align-items: center;
          justify-content: space-between;
          gap: 1rem;
        }

        .footer-copy {
          font-size: 11px;
          color: var(--color-muted);
        }

        .footer-links {
          display: flex;
          gap: 1.2rem;
        }

        .footer-links a {
          font-size: 11px;
          color: var(--color-muted);
          text-decoration: none;
          transition: color var(--transition);
        }

        .footer-links a:hover { color: var(--color-white); }

        /* ── Responsive ── */
        @@media (max-width: 600px) {
          header { padding: 1rem; }
          .header-pill { display: none; }

          main { padding: 3rem 1.25rem; }
          h1 { letter-spacing: -0.8px; }

          .stats { flex-wrap: wrap; }
          .stat-item { max-width: 50%; border-right: none; border-bottom: 1px solid var(--color-border); }
          .stat-item:nth-child(odd) { border-right: 1px solid var(--color-border); }
          .stat-item:last-child, .stat-item:nth-last-child(2):nth-child(odd) { border-bottom: none; }

          footer { flex-direction: column; text-align: center; gap: 0.5rem; }
        }

        @@media (prefers-reduced-motion: reduce) {
          .logo-mark::after, .logo-text::after, .eyebrow-dot { animation: none; }
          .btn-primary { transition: none; }
          .bg-logo-track { animation: none; }
        }
    </style>
</head>
<body>
    <div class="page">

        <!-- Background watermark -->
        <div class="bg-logo" aria-hidden="true">
            <div class="bg-logo-track">
                <div class="bg-logo-item">SENA<span>PAY</span></div>
                <div class="film-mark">◉</div>
                <div class="bg-logo-item">SENA<span>PAY</span></div>
                <div class="film-mark">◉</div>
                <div class="bg-logo-item">SENA<span>PAY</span></div>
                <div class="film-mark">◉</div>
                <div class="bg-logo-item">SENA<span>PAY</span></div>
                <div class="film-mark">◉</div>
            </div>
        </div>

        <!-- Header -->
        <header>
            <a href="/" class="logo" aria-label="SENA PAY inicio">
                <div class="logo-mark" aria-hidden="true">SP</div>
                <span class="logo-text">SENA <span>PAY</span></span>
            </a>
            <div style="display:flex;align-items:center;gap:10px;">
                <span class="header-pill">Plataforma Institucional · SENA</span>
                <button class="theme-toggle" id="themeBtn" aria-label="Cambiar tema">
                    <span class="icon-moon">🌙</span>
                    <span class="icon-sun">☀️</span>
                </button>
            </div>
        </header>

        <!-- Hero -->
        <main>
            <div class="eyebrow">
                <span class="eyebrow-dot" aria-hidden="true"></span>
                Plataforma activa y disponible
            </div>

            <h1>
                El futuro de la gestión<br>
                institucional <em>comienza aquí.</em>
            </h1>

            <p class="subtitle">
                <strong>SENA PAY</strong> te devuelve el tiempo: paga en segundos con tu carné de
                aprendiz o por créditos, sin filas ni esperas. Una plataforma pensada para aprendices,
                administradores y tiendas institucionales, hecha para que te enfoques en lo que
                realmente importa — aprender y crecer.
            </p>

            <div class="cta-wrapper">
                <a asp-area="Account" asp-controller="Account" asp-action="Login" class="btn-primary">
                    Ingresar a SENA PAY
                    <span class="btn-arrow" aria-hidden="true">→</span>
                </a>
                <p class="cta-note">Acceso seguro con credenciales institucionales</p>
            </div>
        </main>

        <!-- Stats strip -->
        <div class="stats" role="list" aria-label="Indicadores de la plataforma">
            <div class="stat-item" role="listitem">
                <div class="stat-number"><span>32</span>s</div>
                <div class="stat-label">Tiempo promedio por trámite</div>
            </div>
            <div class="stat-item" role="listitem">
                <div class="stat-number"><span>0</span> filas</div>
                <div class="stat-label">Procesos 100% en línea</div>
            </div>
            <div class="stat-item" role="listitem">
                <div class="stat-number"><span>3</span> roles</div>
                <div class="stat-label">Usuarios · Admin · Tienda</div>
            </div>
        </div>

        <!-- Footer -->
        <footer>
            <span class="footer-copy">© 2026 SENA PAY — Servicio Nacional de Aprendizaje</span>
            <nav class="footer-links" aria-label="Enlaces del pie">
                <a href="#">Privacidad</a>
                <a href="#">Soporte</a>
                <a href="#">Términos</a>
            </nav>
        </footer>

    </div>
    <script>
        const btn = document.getElementById('themeBtn');
        btn.addEventListener('click', () => {
          document.documentElement.classList.toggle('light');
        });
    </script>
</body>
</html>