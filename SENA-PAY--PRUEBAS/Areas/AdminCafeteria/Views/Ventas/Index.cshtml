@using SenaPay.Application.DTOs.Venta
@{
    ViewData["Title"] = "Mis Ventas";
    ViewData["Breadcrumb"] = "Ventas";
    Layout = "~/Areas/AdminCafeteria/Views/Shared/_Layout.cshtml";

    var ventas = (ViewBag.Ventas as List<VentaTiendaDto>) ?? new();
}

@section Styles {
    <style>
        .inv-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 24px;
            flex-wrap: wrap;
            gap: 12px;
            animation: slideUp .5s cubic-bezier(.22,1,.36,1) both;
        }
        .inv-title { font-family: 'Outfit', sans-serif; font-size: 1.35rem; font-weight: 800; color: var(--text-main); }
        .inv-sub   { font-size: .75rem; color: var(--text-muted); margin-top: 2px; }
        .inv-card  { background: var(--surface); border: 1px solid var(--border); border-radius: 20px; overflow: hidden; animation: slideUp .6s cubic-bezier(.22,1,.36,1) .06s both; }
        .inv-card-header { display: flex; align-items: center; justify-content: space-between; padding: 18px 24px; border-bottom: 1px solid var(--border); }
        .inv-count { font-family: 'Outfit', sans-serif; font-size: .8rem; font-weight: 600; color: var(--text-muted); }
        .inv-count span { color: var(--c); font-size: 1rem; font-weight: 800; }
        .table-scroll { overflow-x: auto; }
        table.inv-table { width: 100%; border-collapse: collapse; }
        table.inv-table th { padding: 11px 16px; font-size: .72rem; font-weight: 700; text-transform: uppercase; letter-spacing: .05em; color: var(--text-muted); text-align: left; background: var(--surface-alt, var(--surface)); border-bottom: 1px solid var(--border); white-space: nowrap; }
        table.inv-table td { padding: 14px 16px; font-size: .85rem; color: var(--text-main); border-bottom: 1px solid var(--border); vertical-align: top; }
        table.inv-table tbody tr:last-child td { border-bottom: none; }
        table.inv-table tbody tr:hover td { background: var(--sena-green-dim, rgba(0,0,0,.03)); }
        .badge { display: inline-block; padding: 3px 10px; border-radius: 20px; font-size: .72rem; font-weight: 700; }
        .badge-ok { background: rgba(34,197,94,.12); color: #16a34a; }
        .venta-items { font-size: .78rem; color: var(--text-muted); margin-top: 3px; line-height: 1.6; }
        .total-col { font-family: 'Outfit', sans-serif; font-weight: 800; color: var(--c); white-space: nowrap; }
        .empty-state { text-align: center; padding: 56px 24px; color: var(--text-muted); }
        .empty-state i { font-size: 2.5rem; margin-bottom: 12px; display: block; }
    </style>
}

<div class="inv-header">
    <div>
        <div class="inv-title">Mis Ventas</div>
        <div class="inv-sub">Últimas 200 transacciones de tu tienda</div>
    </div>
</div>

<div class="inv-card">
    <div class="inv-card-header">
        <span class="inv-count">Total: <span>@ventas.Count</span> venta(s)</span>
    </div>
    <div class="table-scroll">
        @if (!ventas.Any())
        {
            <div class="empty-state">
                <i class="bi bi-receipt"></i>
                <p>No hay ventas registradas aún.</p>
            </div>
        }
        else
        {
            <table class="inv-table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Comprador</th>
                        <th>Cédula</th>
                        <th>Fecha</th>
                        <th>Productos</th>
                        <th>Total</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var v in ventas)
                    {
                        <tr>
                            <td><span class="badge badge-ok">#@v.IdTransaccion</span></td>
                            <td>@v.NombreComprador</td>
                            <td style="font-family:'Courier New',monospace;font-size:.8rem;">@v.Documento</td>
                            <td style="white-space:nowrap;">
                                @v.Fecha.ToString("dd/MM/yyyy")
                                <div style="font-size:.72rem;color:var(--text-muted);">@v.Fecha.ToString("HH:mm")</div>
                            </td>
                            <td>
                                @foreach (var item in v.Items)
                                {
                                    <div class="venta-items">
                                        @item.NombreProducto &times; @item.Cantidad
                                        <span style="color:var(--text-main);font-weight:600;">
                                            — $@item.PrecioUnitario.ToString("N0", new System.Globalization.CultureInfo("es-CO"))
                                        </span>
                                    </div>
                                }
                            </td>
                            <td class="total-col">
                                $@v.Total.ToString("N0", new System.Globalization.CultureInfo("es-CO"))
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>
