@model SenaPay.Application.UseCases.Aprendiz.PerfilAprendizDto
@{
    Layout = null; // Sin layout compartido — página standalone con su propio <head>
    var totalGastos = Model.UltimasTransacciones.Sum(t => t.Total);
    var cantCompras = Model.UltimasTransacciones.Count;
    var iniciales = string.Join("", Model.Nombre.Split(' ')
                           .Where(p => p.Length > 0)
                           .Take(2)
                           .Select(p => p[0].ToString().ToUpper()));
}
<!DOCTYPE html>
<html lang="es" data-theme="dark">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>SenaPay · Mi Perfil</title>

    <!-- Bootstrap Icons -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=Inter:wght@400;500;600&display=swap"
          rel="stylesheet" />

    <style>
        /* ══════════════════════════════════════════════════════════════════
                   TOKEN SYSTEM  —  Dark / Light adaptable
                ══════════════════════════════════════════════════════════════════ */
        :root,
        [data-theme="dark"] {
            --bg-base: #0d0d18;
            --bg-surface: #13131f;
            --bg-card: #1a1a2e;
            --bg-input: #1e1e30;
            --border: rgba(255,255,255,.07);
            --border-strong: rgba(255,255,255,.14);
            --text-primary: #e8eaf0;
            --text-secondary: #94a3b8;
            --text-muted: #5a6478;
            --sena-green: #39A900;
            --sena-green-dim: rgba(57,169,0,.15);
            --sena-green-glow: rgba(57,169,0,.35);
            --accent-blue: #3b82f6;
            --accent-red: #ef4444;
            --accent-amber: #f59e0b;
            --card-shadow: 0 4px 24px rgba(0,0,0,.45);
            --carnet-from: #1a2a1a;
            --carnet-to: #0d1a0d;
        }

        [data-theme="light"] {
            --bg-base: #f0f4f0;
            --bg-surface: #ffffff;
            --bg-card: #ffffff;
            --bg-input: #f3f6f3;
            --border: rgba(0,0,0,.08);
            --border-strong: rgba(0,0,0,.15);
            --text-primary: #1a2e1a;
            --text-secondary: #4a6741;
            --text-muted: #8aab84;
            --sena-green: #2d8a00;
            --sena-green-dim: rgba(45,138,0,.10);
            --sena-green-glow: rgba(45,138,0,.25);
            --accent-blue: #2563eb;
            --accent-red: #dc2626;
            --accent-amber: #d97706;
            --card-shadow: 0 2px 16px rgba(57,169,0,.10);
            --carnet-from: #e8f5e2;
            --carnet-to: #d4edcc;
        }

        /* ── Reset / Base ────────────────────────────────────────────── */
        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Inter', sans-serif;
            background: var(--bg-base);
            color: var(--text-primary);
            min-height: 100vh;
            transition: background .3s, color .3s;
        }

        h1, h2, h3, h4, h5 {
            font-family: 'Outfit', sans-serif;
        }

        /* ── Layout shell ────────────────────────────────────────────── */
        .shell {
            display: grid;
            grid-template-columns: 260px 1fr;
            grid-template-rows: 64px 1fr;
            min-height: 100vh;
        }

        /* ── Topbar ──────────────────────────────────────────────────── */
        .topbar {
            grid-column: 1 / -1;
            background: var(--bg-surface);
            border-bottom: 1px solid var(--border);
            display: flex;
            align-items: center;
            padding: 0 24px;
            gap: 16px;
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .topbar-logo {
            display: flex;
            align-items: center;
            gap: 10px;
            font-family: 'Outfit', sans-serif;
            font-size: 1.2rem;
            font-weight: 700;
            color: var(--sena-green);
            text-decoration: none;
            flex: 0 0 auto;
        }

            .topbar-logo svg {
                width: 28px;
                height: 28px;
            }

        .topbar-divider {
            width: 1px;
            height: 24px;
            background: var(--border);
        }

        .topbar-title {
            font-family: 'Outfit', sans-serif;
            font-size: .85rem;
            font-weight: 500;
            color: var(--text-secondary);
        }

        .topbar-spacer {
            flex: 1;
        }

        /* Theme toggle */
        .btn-theme {
            width: 38px;
            height: 38px;
            border-radius: 10px;
            border: 1px solid var(--border);
            background: var(--bg-card);
            color: var(--text-secondary);
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.1rem;
            transition: background .2s, color .2s, border-color .2s;
        }

            .btn-theme:hover {
                background: var(--sena-green-dim);
                color: var(--sena-green);
                border-color: var(--sena-green);
            }

        /* Avatar topbar */
        .topbar-avatar {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            background: var(--sena-green);
            color: #fff;
            font-family: 'Outfit', sans-serif;
            font-weight: 700;
            font-size: .8rem;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

        /* ── Sidebar ─────────────────────────────────────────────────── */
        .sidebar {
            background: var(--bg-surface);
            border-right: 1px solid var(--border);
            padding: 24px 16px;
            display: flex;
            flex-direction: column;
            gap: 4px;
            position: sticky;
            top: 64px;
            height: calc(100vh - 64px);
            overflow-y: auto;
        }

        .nav-label {
            font-size: .65rem;
            font-weight: 600;
            letter-spacing: .08em;
            text-transform: uppercase;
            color: var(--text-muted);
            padding: 12px 12px 6px;
        }

        .nav-item {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 10px 12px;
            border-radius: 10px;
            font-size: .875rem;
            font-weight: 500;
            color: var(--text-secondary);
            cursor: pointer;
            border: none;
            background: transparent;
            width: 100%;
            text-align: left;
            text-decoration: none;
            transition: background .15s, color .15s;
        }

            .nav-item:hover {
                background: var(--sena-green-dim);
                color: var(--sena-green);
            }

            .nav-item.active {
                background: var(--sena-green-dim);
                color: var(--sena-green);
                font-weight: 600;
            }

            .nav-item i {
                font-size: 1.05rem;
                width: 20px;
                text-align: center;
            }

        .sidebar-bottom {
            margin-top: auto;
            padding-top: 16px;
            border-top: 1px solid var(--border);
        }

        /* ── Main content ────────────────────────────────────────────── */
        .main {
            padding: 28px 32px;
            overflow-y: auto;
            display: flex;
            flex-direction: column;
            gap: 24px;
        }

        /* ── Section visibility ──────────────────────────────────────── */
        .section {
            display: none;
        }

            .section.active {
                display: block;
            }

        /* ── Page header ─────────────────────────────────────────────── */
        .page-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 4px;
        }

            .page-header h2 {
                font-size: 1.4rem;
                font-weight: 700;
                color: var(--text-primary);
            }

            .page-header p {
                font-size: .85rem;
                color: var(--text-secondary);
                margin-top: 2px;
            }

        /* ── Cards ───────────────────────────────────────────────────── */
        .card {
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: 16px;
            padding: 24px;
            box-shadow: var(--card-shadow);
        }

        /* ── Dashboard grid ──────────────────────────────────────────── */
        .dash-grid {
            display: grid;
            grid-template-columns: 340px 1fr;
            gap: 20px;
            align-items: start;
        }

        /* ════════════════════════════════════════════════════════════════
                   CARNET SENA
                ════════════════════════════════════════════════════════════════ */
        .carnet-wrap {
            perspective: 1000px;
        }

        .carnet {
            background: linear-gradient(145deg, var(--carnet-from), var(--carnet-to));
            border: 1px solid var(--sena-green);
            border-radius: 18px;
            padding: 0;
            box-shadow: 0 0 0 1px var(--sena-green-glow), 0 8px 32px rgba(57,169,0,.15), var(--card-shadow);
            overflow: hidden;
            transition: transform .4s ease, box-shadow .4s ease;
            transform-style: preserve-3d;
            position: relative;
        }

            .carnet:hover {
                transform: rotateY(-4deg) rotateX(2deg) translateZ(8px);
                box-shadow: 0 0 0 1px var(--sena-green-glow), 0 16px 48px rgba(57,169,0,.25), var(--card-shadow);
            }

        /* Barra superior verde SENA */
        .carnet-header {
            background: var(--sena-green);
            padding: 12px 20px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .carnet-logo-text {
            font-family: 'Outfit', sans-serif;
            font-size: 1.6rem;
            font-weight: 800;
            color: #fff;
            letter-spacing: .05em;
        }

        .carnet-logo-icon {
            width: 44px;
            height: 44px;
            opacity: .9;
        }

        /* Cuerpo del carnet */
        .carnet-body {
            padding: 20px;
            display: flex;
            flex-direction: column;
            gap: 14px;
        }

        /* Foto + datos principales */
        .carnet-top {
            display: flex;
            gap: 16px;
            align-items: flex-start;
        }

        .carnet-photo {
            width: 72px;
            height: 88px;
            border-radius: 8px;
            background: var(--sena-green-dim);
            border: 2px solid var(--sena-green);
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Outfit', sans-serif;
            font-size: 1.6rem;
            font-weight: 700;
            color: var(--sena-green);
            flex-shrink: 0;
            overflow: hidden;
        }

        .carnet-info {
            flex: 1;
        }

        .carnet-rol-badge {
            display: inline-block;
            font-size: .65rem;
            font-weight: 700;
            letter-spacing: .08em;
            text-transform: uppercase;
            color: var(--sena-green);
            background: var(--sena-green-dim);
            border: 1px solid var(--sena-green);
            border-radius: 4px;
            padding: 2px 8px;
            margin-bottom: 6px;
        }

        .carnet-nombre {
            font-family: 'Outfit', sans-serif;
            font-size: 1.05rem;
            font-weight: 700;
            color: var(--sena-green);
            line-height: 1.2;
        }

        /* Filas de datos del carnet */
        .carnet-rows {
            display: flex;
            flex-direction: column;
            gap: 6px;
            border-top: 1px solid var(--border);
            padding-top: 14px;
        }

        .carnet-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: .78rem;
        }

        .carnet-row-label {
            color: var(--text-muted);
            font-weight: 500;
        }

        .carnet-row-value {
            color: var(--text-primary);
            font-family: 'Outfit', sans-serif;
            font-weight: 600;
            text-align: right;
        }

        /* Código de barras simulado */
        .carnet-barcode {
            height: 36px;
            background: repeating-linear-gradient( 90deg, var(--text-primary) 0px, var(--text-primary) 2px, transparent 2px, transparent 4px, var(--text-primary) 4px, var(--text-primary) 5px, transparent 5px, transparent 8px, var(--text-primary) 8px, var(--text-primary) 10px, transparent 10px, transparent 13px, var(--text-primary) 13px, var(--text-primary) 14px, transparent 14px, transparent 16px );
            border-radius: 3px;
            opacity: .55;
            margin: 0 4px;
        }

        /* Footer del carnet */
        .carnet-footer {
            background: var(--sena-green-dim);
            border-top: 1px solid var(--border);
            padding: 8px 20px;
            text-align: center;
        }

        .carnet-footer-text {
            font-size: .7rem;
            font-weight: 600;
            color: var(--sena-green);
            text-transform: uppercase;
            letter-spacing: .06em;
        }

        /* ── Balance widget ───────────────────────────────────────────── */
        .balance-section {
            display: flex;
            flex-direction: column;
            gap: 16px;
        }

        .balance-card {
            background: linear-gradient(135deg, var(--sena-green) 0%, #2d7a00 100%);
            border-radius: 16px;
            padding: 28px;
            position: relative;
            overflow: hidden;
            box-shadow: 0 8px 32px var(--sena-green-glow);
        }

            .balance-card::before {
                content: '';
                position: absolute;
                top: -30px;
                right: -30px;
                width: 120px;
                height: 120px;
                border-radius: 50%;
                background: rgba(255,255,255,.06);
            }

            .balance-card::after {
                content: '';
                position: absolute;
                bottom: -20px;
                right: 60px;
                width: 80px;
                height: 80px;
                border-radius: 50%;
                background: rgba(255,255,255,.04);
            }

        .balance-label {
            font-size: .8rem;
            font-weight: 500;
            color: rgba(255,255,255,.75);
            text-transform: uppercase;
            letter-spacing: .06em;
            margin-bottom: 8px;
        }

        .balance-amount {
            font-family: 'Outfit', sans-serif;
            font-size: 2.4rem;
            font-weight: 800;
            color: #fff;
            letter-spacing: -.02em;
        }

            .balance-amount.hidden {
                filter: blur(8px);
                user-select: none;
            }

        .balance-toggle {
            position: absolute;
            top: 24px;
            right: 24px;
            width: 34px;
            height: 34px;
            border-radius: 8px;
            background: rgba(255,255,255,.15);
            border: none;
            color: #fff;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1rem;
            transition: background .2s;
        }

            .balance-toggle:hover {
                background: rgba(255,255,255,.25);
            }

        .balance-meta {
            margin-top: 16px;
            font-size: .78rem;
            color: rgba(255,255,255,.65);
        }

        /* Stats row */
        .stats-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
        }

        .stat-card {
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 16px;
        }

        .stat-card-label {
            font-size: .72rem;
            color: var(--text-muted);
            font-weight: 500;
            text-transform: uppercase;
            letter-spacing: .05em;
            margin-bottom: 6px;
        }

        .stat-card-value {
            font-family: 'Outfit', sans-serif;
            font-size: 1.3rem;
            font-weight: 700;
            color: var(--text-primary);
        }

        .stat-card-icon {
            font-size: 1.4rem;
            margin-bottom: 8px;
        }

        /* ── Tienda button ───────────────────────────────────────────── */
        .btn-tienda {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            width: 100%;
            padding: 14px;
            border-radius: 12px;
            background: var(--sena-green);
            color: #fff;
            font-family: 'Outfit', sans-serif;
            font-size: 1rem;
            font-weight: 700;
            border: none;
            cursor: pointer;
            text-decoration: none;
            transition: background .2s, transform .15s, box-shadow .2s;
            box-shadow: 0 4px 16px var(--sena-green-glow);
        }

            .btn-tienda:hover {
                background: #2d8a00;
                transform: translateY(-2px);
                box-shadow: 0 8px 24px var(--sena-green-glow);
            }

            .btn-tienda:active {
                transform: translateY(0);
            }

        /* ── Transacciones ───────────────────────────────────────────── */
        .tx-list {
            display: flex;
            flex-direction: column;
            gap: 0;
        }

        .tx-item {
            display: flex;
            align-items: center;
            gap: 14px;
            padding: 14px 0;
            border-bottom: 1px solid var(--border);
        }

            .tx-item:last-child {
                border-bottom: none;
            }

        .tx-icon {
            width: 40px;
            height: 40px;
            border-radius: 10px;
            background: var(--sena-green-dim);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.1rem;
            color: var(--sena-green);
            flex-shrink: 0;
        }

        .tx-info {
            flex: 1;
            min-width: 0;
        }

        .tx-desc {
            font-size: .875rem;
            font-weight: 600;
            color: var(--text-primary);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .tx-date {
            font-size: .75rem;
            color: var(--text-muted);
            margin-top: 2px;
        }

        .tx-amount {
            font-family: 'Outfit', sans-serif;
            font-size: 1rem;
            font-weight: 700;
            color: var(--accent-red);
            flex-shrink: 0;
        }

        .empty-state {
            text-align: center;
            padding: 40px 20px;
            color: var(--text-muted);
        }

            .empty-state i {
                font-size: 2.5rem;
                margin-bottom: 12px;
                display: block;
            }

            .empty-state p {
                font-size: .875rem;
            }

        /* ── Sección Configuración ───────────────────────────────────── */
        .config-form {
            display: flex;
            flex-direction: column;
            gap: 20px;
            max-width: 520px;
        }

        .form-group {
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

        .form-label {
            font-size: .8rem;
            font-weight: 600;
            color: var(--text-secondary);
            text-transform: uppercase;
            letter-spacing: .05em;
        }

        .form-input {
            background: var(--bg-input);
            border: 1px solid var(--border);
            border-radius: 10px;
            padding: 11px 14px;
            font-size: .9rem;
            color: var(--text-primary);
            font-family: 'Inter', sans-serif;
            transition: border-color .2s;
            outline: none;
        }

            .form-input:focus {
                border-color: var(--sena-green);
            }

            .form-input:disabled {
                opacity: .5;
                cursor: not-allowed;
            }

        .form-hint {
            font-size: .75rem;
            color: var(--text-muted);
        }

        .btn-save {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 11px 24px;
            border-radius: 10px;
            background: var(--sena-green);
            color: #fff;
            font-family: 'Outfit', sans-serif;
            font-weight: 600;
            font-size: .9rem;
            border: none;
            cursor: pointer;
            align-self: flex-start;
            transition: background .2s;
        }

            .btn-save:hover {
                background: #2d8a00;
            }

        /* Sección header dentro de cards */
        .section-head {
            font-family: 'Outfit', sans-serif;
            font-size: 1rem;
            font-weight: 700;
            color: var(--text-primary);
            margin-bottom: 18px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

            .section-head i {
                color: var(--sena-green);
            }

        /* ── Responsive ──────────────────────────────────────────────── */
        @@media (max-width: 900px) {
            .shell

        {
            grid-template-columns: 1fr;
        }

        .sidebar {
            display: none;
        }

        .main {
            padding: 20px 16px;
        }

        .dash-grid {
            grid-template-columns: 1fr;
        }

        }
    </style>
</head>
<body>

    <!-- ═══════════════════════════════════════════════════════════
         SHELL
    ═══════════════════════════════════════════════════════════ -->
    <div class="shell">

        <!-- ── Topbar ──────────────────────────────────────────── -->
        <header class="topbar">
            <a class="topbar-logo" href="#">
                <!-- Logo SENA simplificado en SVG -->
                <svg viewBox="0 0 44 44" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <circle cx="22" cy="22" r="22" fill="var(--sena-green)" fill-opacity=".12" />
                    <circle cx="22" cy="14" r="5" fill="var(--sena-green)" />
                    <path d="M10 34c0-6.627 5.373-12 12-12s12 5.373 12 12" stroke="var(--sena-green)" stroke-width="3" stroke-linecap="round" fill="none" />
                </svg>
                SenaPay
            </a>
            <div class="topbar-divider"></div>
            <span class="topbar-title">Panel Aprendiz</span>
            <div class="topbar-spacer"></div>

            <!-- Toggle dark/light -->
            <button class="btn-theme" id="btnTheme" title="Cambiar tema">
                <i class="bi bi-moon-fill" id="themeIcon"></i>
            </button>

            <!-- Avatar -->
            <div class="topbar-avatar">@iniciales</div>
        </header>

        <!-- ── Sidebar ─────────────────────────────────────────── -->
        <aside class="sidebar">
            <span class="nav-label">Principal</span>

            <button class="nav-item active" onclick="showSection('dashboard', this)">
                <i class="bi bi-grid-fill"></i> Dashboard
            </button>

            <button class="nav-item" onclick="showSection('transacciones', this)">
                <i class="bi bi-arrow-left-right"></i> Movimientos
            </button>

            <span class="nav-label">Servicios</span>

            <a class="nav-item" href="/Tienda">
                <i class="bi bi-shop"></i> Ir a la Tienda
            </a>

            <span class="nav-label">Cuenta</span>

            <button class="nav-item" onclick="showSection('configuracion', this)">
                <i class="bi bi-gear-fill"></i> Configuración
            </button>

            <div class="sidebar-bottom">
                <a class="nav-item" href="/Usuarios/PerfilAprendiz/CerrarSesion"
                   style="color:var(--accent-red);">
                    <i class="bi bi-box-arrow-left"></i> Cerrar sesión
                </a>
            </div>
        </aside>

        <!-- ── Main ────────────────────────────────────────────── -->
        <main class="main">

            <!-- ════════════════════════════════════════════════════
                 SECCIÓN: DASHBOARD
            ════════════════════════════════════════════════════ -->
            <section class="section active" id="sec-dashboard">

                <div class="page-header">
                    <div>
                        <h2>Bienvenido, @Model.Nombre.Split(' ')[0] 👋</h2>
                        <p>Aquí tienes un resumen de tu cuenta SenaPay.</p>
                    </div>
                </div>

                <div class="dash-grid">

                    <!-- ── Carnet SENA ──────────────────────────── -->
                    <div class="carnet-wrap">
                        <div class="carnet">
                            <!-- Header verde -->
                            <div class="carnet-header">
                                <span class="carnet-logo-text">SENA</span>
                                <svg class="carnet-logo-icon" viewBox="0 0 60 60" fill="none">
                                    <circle cx="30" cy="30" r="30" fill="rgba(255,255,255,.15)" />
                                    <circle cx="30" cy="20" r="8" fill="white" />
                                    <path d="M14 50c0-8.837 7.163-16 16-16s16 7.163 16 16"
                                          stroke="white" stroke-width="4" stroke-linecap="round" />
                                </svg>
                            </div>

                            <!-- Cuerpo -->
                            <div class="carnet-body">
                                <div class="carnet-top">
                                    <!-- Foto / iniciales -->
                                    <div class="carnet-photo">@iniciales</div>

                                    <div class="carnet-info">
                                        <span class="carnet-rol-badge">Aprendiz</span>
                                        <div class="carnet-nombre">@Model.Nombre</div>
                                        <div style="font-size:.75rem; color:var(--text-secondary); margin-top:4px;">
                                            @Model.Correo
                                        </div>
                                    </div>
                                </div>

                                <!-- Filas de datos -->
                                <div class="carnet-rows">
                                    <div class="carnet-row">
                                        <span class="carnet-row-label">N.º Documento</span>
                                        <span class="carnet-row-value">@Model.Documento</span>
                                    </div>
                                    <div class="carnet-row">
                                        <span class="carnet-row-label">N.º Ficha</span>
                                        <span class="carnet-row-value">@Model.Ficha</span>
                                    </div>
                                    <div class="carnet-row">
                                        <span class="carnet-row-label">Sede</span>
                                        <span class="carnet-row-value">@Model.Sede</span>
                                    </div>
                                    <div class="carnet-row">
                                        <span class="carnet-row-label">Programa</span>
                                        <span class="carnet-row-value"
                                              style="font-size:.7rem; max-width:160px; text-align:right; line-height:1.3;">
                                            Análisis y Desarrollo de Software
                                        </span>
                                    </div>
                                </div>

                                <!-- Código de barras simulado -->
                                <div class="carnet-barcode"></div>
                            </div>

                            <!-- Footer -->
                            <div class="carnet-footer">
                                <span class="carnet-footer-text">
                                    Servicio Nacional de Aprendizaje · Regional Boyacá
                                </span>
                            </div>
                        </div>
                    </div>

                    <!-- ── Columna derecha: balance + stats + tienda ── -->
                    <div class="balance-section">

                        <!-- Balance card -->
                        <div class="balance-card">
                            <div class="balance-label">Saldo disponible</div>
                            <div class="balance-amount" id="balanceAmount">
                                $@Model.Saldo.ToString("N0", new System.Globalization.CultureInfo("es-CO"))
                            </div>
                            <div class="balance-meta">Cuenta SenaPay · Aprendiz</div>
                            <button class="balance-toggle" id="balanceToggle" title="Mostrar/ocultar saldo">
                                <i class="bi bi-eye-fill" id="balanceEyeIcon"></i>
                            </button>
                        </div>

                        <!-- Stats -->
                        <div class="stats-row">
                            <div class="stat-card">
                                <div class="stat-card-icon" style="color:var(--accent-red);">
                                    <i class="bi bi-graph-down-arrow"></i>
                                </div>
                                <div class="stat-card-label">Gastos totales</div>
                                <div class="stat-card-value">
                                    $@totalGastos.ToString("N0", new System.Globalization.CultureInfo("es-CO"))
                                </div>
                            </div>
                            <div class="stat-card">
                                <div class="stat-card-icon" style="color:var(--accent-amber);">
                                    <i class="bi bi-bag-check-fill"></i>
                                </div>
                                <div class="stat-card-label">Compras</div>
                                <div class="stat-card-value">@cantCompras</div>
                            </div>
                        </div>

                        <!-- Botón Tienda -->
                        <a class="btn-tienda" href="/Tienda">
                            <i class="bi bi-shop-window"></i>
                            Ir a la Tienda SENA
                            <i class="bi bi-arrow-right"></i>
                        </a>

                    </div>
                </div>

                <!-- Últimas transacciones (preview en dashboard) -->
                <div class="card" style="margin-top:24px;">
                    <div class="section-head">
                        <i class="bi bi-clock-history"></i> Últimos movimientos
                    </div>

                    @if (!Model.UltimasTransacciones.Any())
                    {
                        <div class="empty-state">
                            <i class="bi bi-inbox"></i>
                            <p>Aún no tienes movimientos registrados.</p>
                        </div>
                    }
                    else
                    {
                        <div class="tx-list">
                            @foreach (var tx in Model.UltimasTransacciones.Take(5))
                            {
                                <div class="tx-item">
                                    <div class="tx-icon">
                                        <i class="bi bi-bag-fill"></i>
                                    </div>
                                    <div class="tx-info">
                                        <div class="tx-desc">@tx.Descripcion</div>
                                        <div class="tx-date">@tx.Fecha.ToString("dd MMM yyyy · HH:mm")</div>
                                    </div>
                                    <div class="tx-amount">
                                        −$@tx.Total.ToString("N0", new System.Globalization.CultureInfo("es-CO"))
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>

            </section>

            <!-- ════════════════════════════════════════════════════
                 SECCIÓN: MOVIMIENTOS COMPLETOS
            ════════════════════════════════════════════════════ -->
            <section class="section" id="sec-transacciones">

                <div class="page-header" style="margin-bottom:20px;">
                    <div>
                        <h2>Historial de movimientos</h2>
                        <p>Todas tus transacciones registradas en SenaPay.</p>
                    </div>
                </div>

                <div class="card">
                    @if (!Model.UltimasTransacciones.Any())
                    {
                        <div class="empty-state">
                            <i class="bi bi-inbox"></i>
                            <p>Aún no tienes movimientos registrados.</p>
                        </div>
                    }
                    else
                    {
                        <div class="tx-list">
                            @foreach (var tx in Model.UltimasTransacciones)
                            {
                                <div class="tx-item">
                                    <div class="tx-icon">
                                        <i class="bi bi-bag-fill"></i>
                                    </div>
                                    <div class="tx-info">
                                        <div class="tx-desc">@tx.Descripcion</div>
                                        <div class="tx-date">
                                            @tx.Fecha.ToString("dddd, dd 'de' MMMM 'de' yyyy · HH:mm",
                                                     new System.Globalization.CultureInfo("es-CO"))
                                            &nbsp;·&nbsp; ID #@tx.IdTransaccion
                                        </div>
                                    </div>
                                    <div class="tx-amount">
                                        −$@tx.Total.ToString("N0", new System.Globalization.CultureInfo("es-CO"))
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>

            </section>

            <!-- ════════════════════════════════════════════════════
                 SECCIÓN: CONFIGURACIÓN
            ════════════════════════════════════════════════════ -->
            <section class="section" id="sec-configuracion">

                <div class="page-header" style="margin-bottom:20px;">
                    <div>
                        <h2>Configuración de perfil</h2>
                        <p>Actualiza tu información de contacto.</p>
                    </div>
                </div>

                <div class="card">
                    <div class="section-head">
                        <i class="bi bi-person-circle"></i> Datos personales
                    </div>
                    <div class="config-form">
                        <div class="form-group">
                            <label class="form-label">Nombre completo</label>
                            <input class="form-input" type="text" value="@Model.Nombre" disabled />
                            <span class="form-hint">El nombre no se puede modificar desde aquí.</span>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Correo electrónico</label>
                            <input class="form-input" type="email" id="cfg-correo" value="@Model.Correo" />
                        </div>
                        <div class="form-group">
                            <label class="form-label">Teléfono</label>
                            <input class="form-input" type="tel" id="cfg-telefono"
                                   value="@(Model.Telefono ?? "")"
                                   placeholder="Ej: 3101234567" />
                        </div>
                        <div class="form-group">
                            <label class="form-label">Documento</label>
                            <input class="form-input" type="text" value="@Model.Documento" disabled />
                        </div>

                        <button class="btn-save" onclick="guardarConfiguracion()">
                            <i class="bi bi-floppy2-fill"></i> Guardar cambios
                        </button>
                    </div>
                </div>

            </section>

        </main>
    </div>

    <!-- ════════════════════════════════════════════════════════════════
         TOAST
    ════════════════════════════════════════════════════════════════ -->
    <div id="toastPanel" style="
    position:fixed; bottom:28px; right:28px; z-index:9999;
    background:var(--bg-card); border:1px solid var(--border);
    border-radius:14px; padding:16px 20px;
    display:flex; align-items:center; gap:12px;
    box-shadow:var(--card-shadow);
    transform:translateY(120px); opacity:0;
    transition:transform .35s cubic-bezier(.34,1.56,.64,1), opacity .3s;
    min-width:280px; max-width:380px;">
        <div id="toastIcon" style="width:36px;height:36px;border-radius:10px;
         display:flex;align-items:center;justify-content:center;font-size:1.2rem;flex-shrink:0;">
            <i id="toastIco" class="bi bi-check2-circle"></i>
        </div>
        <div style="flex:1;min-width:0;">
            <div id="toastTitle" style="font-family:'Outfit',sans-serif;font-weight:700;
             font-size:.9rem;color:var(--text-primary);"></div>
            <div id="toastMsg" style="font-size:.8rem;color:var(--text-secondary);margin-top:2px;"></div>
        </div>
        <button onclick="hideToast()"
                style="background:none;border:none;color:var(--text-muted);cursor:pointer;font-size:1rem;padding:4px;">
            <i class="bi bi-x"></i>
        </button>
    </div>

    <!-- ════════════════════════════════════════════════════════════════
         JAVASCRIPT
    ════════════════════════════════════════════════════════════════ -->
    <script>
        // ── Theme toggle ──────────────────────────────────────────────
        const root      = document.documentElement;
        const btnTheme  = document.getElementById('btnTheme');
        const themeIcon = document.getElementById('themeIcon');

        // Lee la preferencia guardada o el sistema
        function getStoredTheme() {
            return localStorage.getItem('sp-theme') ||
                (window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
        }

        function applyTheme(theme) {
            root.setAttribute('data-theme', theme);
            themeIcon.className = theme === 'dark' ? 'bi bi-moon-fill' : 'bi bi-sun-fill';
            localStorage.setItem('sp-theme', theme);
        }

        applyTheme(getStoredTheme());

        btnTheme.addEventListener('click', () => {
            applyTheme(root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark');
        });

        // ── Navigation ────────────────────────────────────────────────
        function showSection(sec, btn) {
            document.querySelectorAll('.section').forEach(s => s.classList.remove('active'));
            document.getElementById('sec-' + sec).classList.add('active');
            document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active'));
            if (btn) btn.classList.add('active');
        }

        // ── Balance toggle ────────────────────────────────────────────
        let saldoVisible = true;
        const balanceAmount = document.getElementById('balanceAmount');
        const balanceEyeIcon = document.getElementById('balanceEyeIcon');

        document.getElementById('balanceToggle').addEventListener('click', () => {
            saldoVisible = !saldoVisible;
            balanceAmount.classList.toggle('hidden', !saldoVisible);
            balanceEyeIcon.className = saldoVisible ? 'bi bi-eye-fill' : 'bi bi-eye-slash-fill';
        });

        // ── Toast ─────────────────────────────────────────────────────
        let toastTimer;
        function showToast(type, title, msg) {
            const panel = document.getElementById('toastPanel');
            const icon  = document.getElementById('toastIcon');
            document.getElementById('toastTitle').textContent = title;
            document.getElementById('toastMsg').textContent   = msg;

            const isSuccess = type === 'success';
            icon.style.background = isSuccess ? 'rgba(57,169,0,.15)' : 'rgba(239,68,68,.15)';
            icon.style.color       = isSuccess ? 'var(--sena-green)' : 'var(--accent-red)';
            document.getElementById('toastIco').className = isSuccess
                ? 'bi bi-check2-circle' : 'bi bi-x-circle';

            panel.style.transform = 'translateY(0)';
            panel.style.opacity   = '1';
            clearTimeout(toastTimer);
            toastTimer = setTimeout(hideToast, 4000);
        }
        function hideToast() {
            const panel = document.getElementById('toastPanel');
            panel.style.transform = 'translateY(120px)';
            panel.style.opacity   = '0';
        }

        // ── Configuración: guardar (placeholder → conectar a endpoint) ─
        async function guardarConfiguracion() {
            const correo   = document.getElementById('cfg-correo').value.trim();
            const telefono = document.getElementById('cfg-telefono').value.trim();

            if (!correo || !/^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/.test(correo)) {
                showToast('error', 'Error', 'Ingresa un correo válido.');
                return;
            }

            try {
                const res = await fetch('/Usuarios/PerfilAprendiz/ActualizarPerfil', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ correo, telefono })
                });
                const data = await res.json();
                data.ok
                    ? showToast('success', '¡Guardado!', data.msg ?? 'Perfil actualizado correctamente.')
                    : showToast('error', 'Error', data.msg ?? 'No se pudo guardar.');
            } catch {
                showToast('error', 'Error', 'Problema de conexión con el servidor.');
            }
        }
    </script>
</body>
</html>
