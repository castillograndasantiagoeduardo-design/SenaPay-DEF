@model IEnumerable<SenaPay.Application.DTOs.Categoria.CategoriaSeleccionDto>
@{
    ViewData["Title"] = "Categorías";
    ViewData["Breadcrumb"] = "Categorías de mi tienda";
    Layout = "~/Areas/AdminCafeteria/Views/Shared/_Layout.cshtml";
    var categorias = Model.ToList();
    var habilitadas = categorias.Count(c => c.Habilitada);
    var deshabilitadas = categorias.Count(c => !c.Habilitada);
}

@section Styles {
    <style>
        /* ── Page header ── */
        .cat-page-header {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 16px;
            margin-bottom: 28px;
            flex-wrap: wrap;
            animation: slideUp .5s cubic-bezier(.22,1,.36,1) both;
        }

        .cat-page-title {
            font-family: 'Outfit', sans-serif;
            font-size: 1.35rem;
            font-weight: 800;
            color: var(--text-main);
            margin-bottom: 4px;
        }

        .cat-page-sub {
            font-size: .78rem;
            color: var(--text-muted);
            line-height: 1.5;
            max-width: 480px;
        }

        /* ── Stats strip ── */
        .cat-stats {
            display: flex;
            gap: 12px;
            margin-bottom: 24px;
            flex-wrap: wrap;
            animation: slideUp .55s cubic-bezier(.22,1,.36,1) .04s both;
        }

        .cat-stat-pill {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 10px 16px;
            border-radius: 12px;
            border: 1px solid var(--border);
            background: var(--surface);
            font-size: .78rem;
            font-family: 'Outfit', sans-serif;
            font-weight: 600;
            color: var(--text-muted);
        }

        .cat-stat-pill .pill-num {
            font-size: 1.1rem;
            font-weight: 800;
            color: var(--text-main);
        }

        .cat-stat-pill.active  { border-color: rgba(34,197,94,.25);  background: rgba(34,197,94,.06); }
        .cat-stat-pill.inactive{ border-color: rgba(100,116,139,.2); background: rgba(100,116,139,.05); }
        .cat-stat-pill.total   { border-color: rgba(232,108,0,.25);  background: rgba(232,108,0,.06); }

        .pill-dot {
            width: 8px; height: 8px;
            border-radius: 50%;
            flex-shrink: 0;
        }

        .pill-dot.green  { background: #22c55e; box-shadow: 0 0 6px rgba(34,197,94,.5); }
        .pill-dot.gray   { background: #64748b; }
        .pill-dot.amber  { background: var(--c); box-shadow: 0 0 6px rgba(232,108,0,.4); }

        /* ── Section label ── */
        .section-divider {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 14px;
            font-family: 'Outfit', sans-serif;
            font-size: .65rem;
            font-weight: 700;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 1.2px;
            animation: slideUp .58s cubic-bezier(.22,1,.36,1) .06s both;
        }

        .section-divider::after {
            content: '';
            flex: 1;
            height: 1px;
            background: var(--border);
        }

        /* ── Category grid ── */
        .cat-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
            gap: 14px;
            margin-bottom: 32px;
            animation: slideUp .6s cubic-bezier(.22,1,.36,1) .08s both;
        }

        .cat-card {
            background: var(--surface);
            border: 1.5px solid var(--border);
            border-radius: 16px;
            padding: 20px;
            display: flex;
            flex-direction: column;
            gap: 12px;
            transition: transform .2s, box-shadow .2s, border-color .2s;
            position: relative;
            overflow: hidden;
        }

        .cat-card.enabled {
            border-color: rgba(232,108,0,.3);
            background: linear-gradient(135deg, rgba(232,108,0,.04), transparent);
        }

        .cat-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 24px rgba(0,0,0,.08);
        }

        .cat-card.enabled:hover {
            box-shadow: 0 8px 24px rgba(232,108,0,.12);
        }

        /* Accent top line */
        .cat-card.enabled::before {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0;
            height: 2px;
            background: linear-gradient(90deg, var(--c), #fb923c);
        }

        .cat-card-top {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 8px;
        }

        .cat-card-icon {
            width: 44px;
            height: 44px;
            border-radius: 12px;
            display: grid;
            place-items: center;
            font-size: 20px;
            flex-shrink: 0;
            transition: background .2s;
        }

        .cat-card.enabled  .cat-card-icon { background: rgba(232,108,0,.15); color: var(--c); }
        .cat-card.disabled .cat-card-icon { background: rgba(100,116,139,.1); color: #64748b; }

        .cat-status-badge {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            padding: 3px 8px;
            border-radius: 99px;
            font-size: .6rem;
            font-weight: 700;
            font-family: 'Outfit', sans-serif;
            letter-spacing: .4px;
        }

        .badge-on  { background: rgba(34,197,94,.1);   color: #16a34a; }
        .badge-off { background: rgba(100,116,139,.1); color: #64748b; }

        .cat-card-name {
            font-family: 'Outfit', sans-serif;
            font-size: .95rem;
            font-weight: 700;
            color: var(--text-main);
        }

        .cat-card-id {
            font-size: .68rem;
            color: var(--text-muted);
        }

        /* Toggle button */
        .btn-toggle-cat {
            width: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            padding: 10px;
            border-radius: 10px;
            border: none;
            font-family: 'Outfit', sans-serif;
            font-size: .78rem;
            font-weight: 700;
            cursor: pointer;
            transition: all .2s;
            letter-spacing: .3px;
        }

        .cat-card.enabled  .btn-toggle-cat {
            background: rgba(239,68,68,.08);
            color: #ef4444;
            border: 1px solid rgba(239,68,68,.15);
        }

        .cat-card.enabled  .btn-toggle-cat:hover {
            background: rgba(239,68,68,.14);
            border-color: rgba(239,68,68,.3);
        }

        .cat-card.disabled .btn-toggle-cat {
            background: rgba(232,108,0,.1);
            color: var(--c);
            border: 1px solid rgba(232,108,0,.2);
        }

        .cat-card.disabled .btn-toggle-cat:hover {
            background: rgba(232,108,0,.18);
            border-color: rgba(232,108,0,.35);
        }

        /* ── Empty state ── */
        .empty-cats {
            text-align: center;
            padding: 56px 24px;
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 20px;
            animation: slideUp .6s cubic-bezier(.22,1,.36,1) .06s both;
        }

        .empty-cats-icon {
            width: 64px; height: 64px;
            border-radius: 18px;
            background: rgba(232,108,0,.08);
            display: grid;
            place-items: center;
            font-size: 28px;
            color: var(--c);
            margin: 0 auto 14px;
        }

        .empty-cats-title {
            font-family: 'Outfit', sans-serif;
            font-size: 1rem;
            font-weight: 700;
            color: var(--text-main);
            margin-bottom: 6px;
        }

        .empty-cats-sub {
            font-size: .8rem;
            color: var(--text-muted);
            line-height: 1.6;
            max-width: 360px;
            margin: 0 auto;
        }

        /* ── Info banner ── */
        .info-banner {
            display: flex;
            align-items: flex-start;
            gap: 12px;
            background: rgba(59,130,246,.06);
            border: 1px solid rgba(59,130,246,.2);
            border-radius: 12px;
            padding: 14px 18px;
            margin-bottom: 24px;
            font-size: .78rem;
            color: var(--text-muted);
            line-height: 1.5;
            animation: slideUp .52s cubic-bezier(.22,1,.36,1) .02s both;
        }

        .info-banner i {
            color: #3b82f6;
            font-size: 16px;
            flex-shrink: 0;
            margin-top: 1px;
        }

        @@media (max-width: 640px) {
            .cat-grid { grid-template-columns: repeat(2, 1fr); }
            .cat-page-header { flex-direction: column; }
        }

        @@media (max-width: 400px) {
            .cat-grid { grid-template-columns: 1fr; }
        }
    </style>
}

<!-- ── Page Header ── -->
<div class="cat-page-header">
    <div>
        <div class="cat-page-title">Categorías de mi tienda</div>
        <div class="cat-page-sub">
            Habilita o deshabilita las categorías que quieres usar en tu tienda.
            Solo verás las categorías habilitadas al crear productos.
        </div>
    </div>
</div>

<!-- ── Info banner ── -->
<div class="info-banner">
    <i class="bi bi-info-circle-fill"></i>
    <span>
        Las categorías globales las crea el <strong>Funcionario</strong>.
        Aquí solo decides cuáles aplican para <strong>tu tienda</strong>.
        Deshabilitar una categoría no elimina los productos que ya la tienen asignada.
    </span>
</div>

<!-- ── Stats ── -->
<div class="cat-stats">
    <div class="cat-stat-pill total">
        <div class="pill-dot amber"></div>
        <span class="pill-num">@categorias.Count</span>
        disponibles en total
    </div>
    <div class="cat-stat-pill active">
        <div class="pill-dot green"></div>
        <span class="pill-num">@habilitadas</span>
        habilitada@(habilitadas != 1 ? "s" : "") en tu tienda
    </div>
    <div class="cat-stat-pill inactive">
        <div class="pill-dot gray"></div>
        <span class="pill-num">@deshabilitadas</span>
        deshabilitada@(deshabilitadas != 1 ? "s" : "")
    </div>
</div>

@if (!categorias.Any())
{
    <div class="empty-cats">
        <div class="empty-cats-icon"><i class="bi bi-tags"></i></div>
        <div class="empty-cats-title">No hay categorías globales aún</div>
        <div class="empty-cats-sub">
            Pide a un <strong>Funcionario</strong> que cree categorías globales
            para que puedas habilitarlas en tu tienda.
        </div>
    </div>
}
else
{
    <!-- ── Habilitadas ── -->
    @if (categorias.Any(c => c.Habilitada))
    {
        <div class="section-divider">
            <i class="bi bi-check-circle-fill" style="color:#22c55e; font-size:13px"></i>
            Habilitadas (@habilitadas)
        </div>

        <div class="cat-grid">
            @foreach (var cat in categorias.Where(c => c.Habilitada))
            {
                <div class="cat-card enabled">
                    <div class="cat-card-top">
                        <div class="cat-card-icon">
                            <i class="bi bi-tag-fill"></i>
                        </div>
                        <span class="cat-status-badge badge-on">
                            <i class="bi bi-check-lg"></i> Activa
                        </span>
                    </div>
                    <div>
                        <div class="cat-card-name">@cat.NombreCategoria</div>
                        <div class="cat-card-id">#@cat.IdCategoria</div>
                    </div>
                    <form asp-area="AdminCafeteria"
                          asp-controller="Categorias"
                          asp-action="Toggle"
                          method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="idCategoria" value="@cat.IdCategoria" />
                        <input type="hidden" name="habilitar" value="false" />
                        <button type="button" class="btn-toggle-cat"
                                onclick="confirmarToggle(this, '@Html.Raw(cat.NombreCategoria.Replace("'","\\\'"))', false)">
                            <i class="bi bi-slash-circle"></i>
                            Deshabilitar
                        </button>
                    </form>
                </div>
            }
        </div>
    }

    <!-- ── Deshabilitadas ── -->
    @if (categorias.Any(c => !c.Habilitada))
    {
        <div class="section-divider">
            <i class="bi bi-dash-circle" style="color:#64748b; font-size:13px"></i>
            Deshabilitadas (@deshabilitadas)
        </div>

        <div class="cat-grid">
            @foreach (var cat in categorias.Where(c => !c.Habilitada))
            {
                <div class="cat-card disabled">
                    <div class="cat-card-top">
                        <div class="cat-card-icon">
                            <i class="bi bi-tag"></i>
                        </div>
                        <span class="cat-status-badge badge-off">
                            <i class="bi bi-dash-lg"></i> Inactiva
                        </span>
                    </div>
                    <div>
                        <div class="cat-card-name">@cat.NombreCategoria</div>
                        <div class="cat-card-id">#@cat.IdCategoria</div>
                    </div>
                    <form asp-area="AdminCafeteria"
                          asp-controller="Categorias"
                          asp-action="Toggle"
                          method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="idCategoria" value="@cat.IdCategoria" />
                        <input type="hidden" name="habilitar" value="true" />
                        <button type="button" class="btn-toggle-cat"
                                onclick="confirmarToggle(this, '@Html.Raw(cat.NombreCategoria.Replace("'","\\\'"))', true)">
                            <i class="bi bi-check-circle"></i>
                            Habilitar
                        </button>
                    </form>
                </div>
            }
        </div>
    }
}

@section Scripts {
    <script>
        function confirmarToggle(btn, nombre, habilitar) {
            const accion  = habilitar ? 'habilitar' : 'deshabilitar';
            const icono   = habilitar ? 'success'   : 'warning';
            const btnText = habilitar ? 'Sí, habilitar' : 'Sí, deshabilitar';
            const color   = habilitar ? '#E86C00' : '#ef4444';

            Swal.fire({
                title: `¿${accion.charAt(0).toUpperCase() + accion.slice(1)} categoría?`,
                html: `<span style="color:#8890a8">Se va a <strong style="color:#f0f0ff">${accion}</strong> la categoría <strong style="color:#f0f0ff">${nombre}</strong> en tu tienda.</span>`,
                icon: icono,
                background: '#13131f',
                color: '#f0f0ff',
                iconColor: color,
                showCancelButton: true,
                confirmButtonText: btnText,
                cancelButtonText: 'Cancelar',
                confirmButtonColor: color,
                cancelButtonColor: '#2a2a3e',
            }).then(result => {
                if (result.isConfirmed)
                    btn.closest('form').submit();
            });
        }
    </script>
}
