@{
    Layout = null;
    var nombre = User.Identity?.Name ?? "Funcionario";
    var iniciales = string.Join("", nombre.Split(' ')
        .Where(p => p.Length > 0).Take(2)
        .Select(p => p[0].ToString().ToUpper()));
}
<!DOCTYPE html>
<html lang="es" data-theme="dark">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>SenaPay · Seleccionar modo</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
    <script>(function(){var t=localStorage.getItem('sp-theme');if(t)document.documentElement.setAttribute('data-theme',t);})();</script>
    <style>
        :root,[data-theme="dark"]{
            --bg-base:#0d0d18;--bg-surface:#13131f;--bg-card:#1a1a2e;
            --border:rgba(255,255,255,.07);--border-strong:rgba(255,255,255,.14);
            --text-primary:#e8eaf0;--text-secondary:#94a3b8;--text-muted:#5a6478;
            --purple:#7C3AED;--purple-dim:rgba(124,58,237,.15);--purple-glow:rgba(124,58,237,.35);
            --green:#39A900;--green-dim:rgba(57,169,0,.12);
            --card-shadow:0 4px 24px rgba(0,0,0,.45);
        }
        [data-theme="light"]{
            --bg-base:#f4f3ff;--bg-surface:#fff;--bg-card:#fff;
            --border:rgba(0,0,0,.08);--border-strong:rgba(0,0,0,.15);
            --text-primary:#1a1535;--text-secondary:#5b4fa8;--text-muted:#8a82b8;
            --purple:#6D28D9;--purple-dim:rgba(109,40,217,.10);--purple-glow:rgba(109,40,217,.25);
            --green:#2d8a00;--green-dim:rgba(45,138,0,.10);
            --card-shadow:0 2px 16px rgba(109,40,217,.12);
        }
        *,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
        body{font-family:'Inter',sans-serif;background:var(--bg-base);color:var(--text-primary);
             min-height:100vh;display:flex;flex-direction:column;}
        h1,h2,h3{font-family:'Outfit',sans-serif;}

        /* Topbar */
        .topbar{background:var(--bg-surface);border-bottom:1px solid var(--border);
                display:flex;align-items:center;padding:0 24px;gap:14px;height:62px;
                position:sticky;top:0;z-index:100;}
        .logo{font-family:'Outfit',sans-serif;font-size:1.25rem;font-weight:800;
              background:linear-gradient(135deg,var(--purple),#a855f7);
              -webkit-background-clip:text;-webkit-text-fill-color:transparent;}
        .topbar-right{margin-left:auto;display:flex;align-items:center;gap:12px;}
        .avatar{width:36px;height:36px;border-radius:50%;background:var(--purple-dim);
                border:2px solid var(--purple);display:flex;align-items:center;
                justify-content:center;font-weight:700;font-size:.75rem;color:var(--purple);}
        .theme-btn{background:none;border:1px solid var(--border-strong);border-radius:8px;
                   padding:6px 10px;cursor:pointer;color:var(--text-secondary);font-size:.9rem;}

        /* Hero */
        .hero{flex:1;display:flex;flex-direction:column;align-items:center;
              justify-content:center;padding:48px 24px;text-align:center;}
        .hero-badge{display:inline-flex;align-items:center;gap:8px;
                    background:var(--purple-dim);border:1px solid rgba(124,58,237,.3);
                    border-radius:100px;padding:6px 16px;font-size:.8rem;
                    color:var(--purple);font-weight:600;margin-bottom:24px;}
        .hero h1{font-size:clamp(1.6rem,4vw,2.4rem);font-weight:800;line-height:1.2;
                 margin-bottom:10px;}
        .hero p{color:var(--text-secondary);max-width:480px;line-height:1.6;margin-bottom:48px;}

        /* Cards de modo */
        .cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));
               gap:20px;max-width:680px;width:100%;}
        .mode-card{background:var(--bg-card);border:1px solid var(--border);
                   border-radius:20px;padding:32px 28px;cursor:pointer;text-decoration:none;
                   color:inherit;display:flex;flex-direction:column;gap:16px;
                   box-shadow:var(--card-shadow);transition:transform .2s,border-color .2s,box-shadow .2s;}
        .mode-card:hover{transform:translateY(-4px);}
        .mode-card.admin:hover{border-color:var(--purple);box-shadow:0 8px 32px var(--purple-dim);}
        .mode-card.tienda:hover{border-color:var(--green);box-shadow:0 8px 32px var(--green-dim);}
        .card-icon{width:56px;height:56px;border-radius:16px;display:flex;
                   align-items:center;justify-content:center;font-size:1.5rem;}
        .admin .card-icon{background:var(--purple-dim);color:var(--purple);}
        .tienda .card-icon{background:var(--green-dim);color:var(--green);}
        .card-title{font-family:'Outfit',sans-serif;font-size:1.25rem;font-weight:700;}
        .card-desc{color:var(--text-secondary);font-size:.9rem;line-height:1.5;}
        .card-arrow{margin-top:auto;display:flex;align-items:center;gap:6px;
                    font-size:.85rem;font-weight:600;}
        .admin .card-arrow{color:var(--purple);}
        .tienda .card-arrow{color:var(--green);}

        /* Logout link */
        .logout-link{margin-top:32px;font-size:.85rem;color:var(--text-muted);}
        .logout-link a{color:#ef4444;text-decoration:none;}
        .logout-link a:hover{text-decoration:underline;}
    </style>
</head>
<body>
    <header class="topbar">
        <span class="logo">SenaPay</span>
        <div class="topbar-right">
            <button class="theme-btn" onclick="toggleTheme()" title="Cambiar tema">
                <i class="bi bi-circle-half"></i>
            </button>
            <div class="avatar" title="@nombre">@iniciales</div>
        </div>
    </header>

    <main class="hero">
        <div class="hero-badge">
            <i class="bi bi-person-badge-fill"></i>
            Bienvenido, @nombre
        </div>
        <h1>¿Cómo deseas ingresar hoy?</h1>
        <p>Elige el modo de acceso. Puedes cambiar en cualquier momento cerrando sesión.</p>

        <div class="cards">
            <a asp-area="Funcionarios" asp-controller="Funcionarios" asp-action="AgregarUsuarios"
               class="mode-card admin">
                <div class="card-icon"><i class="bi bi-people-fill"></i></div>
                <div class="card-title">Modo Administrar</div>
                <div class="card-desc">Gestión de usuarios, tiendas, reportes y categorías del sistema.</div>
                <div class="card-arrow">Entrar <i class="bi bi-arrow-right"></i></div>
            </a>

            <a asp-area="Tiendas" asp-controller="Tienda" asp-action="CarnetFuncionario"
               class="mode-card tienda">
                <div class="card-icon"><i class="bi bi-shop-window"></i></div>
                <div class="card-title">Modo Tienda</div>
                <div class="card-desc">Accede a la tienda como cliente para hacer reservas de productos.</div>
                <div class="card-arrow">Entrar <i class="bi bi-arrow-right"></i></div>
            </a>
        </div>

        <div class="logout-link">
            ¿Quieres salir?
            <a asp-area="Account" asp-controller="Account" asp-action="Logout">Cerrar sesión</a>
        </div>
    </main>

    <script>
        function toggleTheme() {
            const html = document.documentElement;
            const t = html.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
            html.setAttribute('data-theme', t);
            localStorage.setItem('sp-theme', t);
        }
    </script>
    @Html.AntiForgeryToken()
</body>
</html>
