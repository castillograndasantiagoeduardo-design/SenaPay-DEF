@using SenaPay.Application.DTOs.Tienda
@using SenaPay.Application.DTOs.Carrito
@model TiendaViewModel
@{
    Layout = null;
    var nombre = ViewBag.NombreUsuario as string ?? "Usuario";
    var esAprendiz = (bool)(ViewBag.EsAprendiz ?? true);
    var sedeNombre = ViewBag.SedeNombre as string ?? "Sede";
    var tiendaNombre = ViewBag.TiendaNombre as string ?? "Tienda";
    var idSede = (int)(ViewBag.IdSede ?? 0);
    var carritoInicial = ViewBag.Carrito as List<ItemCarritoDto> ?? new List<ItemCarritoDto>();
    var iniciales = nombre.Split(' ')
        .Where(p => p.Length > 0).Take(2)
        .Select(p => p[0].ToString().ToUpper())
        .Aggregate("", (a, b) => a + b);
    var carritoJson = System.Text.Json.JsonSerializer.Serialize(carritoInicial,
        new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase });
    var ci = new System.Globalization.CultureInfo("es-CO");
}
<!DOCTYPE html>
<html lang="es" data-theme="dark">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>SenaPay · @tiendaNombre</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
    <script>(function(){var t=localStorage.getItem('sp-theme');if(t)document.documentElement.setAttribute('data-theme',t);})();</script>
    <style>
        :root,[data-theme="dark"]{--bg-base:#0d0d18;--bg-surface:#13131f;--bg-card:#1a1a2e;--bg-input:#1e1e30;--border:rgba(255,255,255,.07);--border-strong:rgba(255,255,255,.14);--text-primary:#e8eaf0;--text-secondary:#94a3b8;--text-muted:#5a6478;--sena-green:#39A900;--sena-green-dim:rgba(57,169,0,.15);--sena-green-glow:rgba(57,169,0,.35);--accent-red:#ef4444;--accent-amber:#f59e0b;--card-shadow:0 4px 24px rgba(0,0,0,.45);}
        [data-theme="light"]{--bg-base:#f0f4f0;--bg-surface:#fff;--bg-card:#fff;--bg-input:#f3f6f3;--border:rgba(0,0,0,.08);--border-strong:rgba(0,0,0,.15);--text-primary:#1a2e1a;--text-secondary:#4a6741;--text-muted:#8aab84;--sena-green:#2d8a00;--sena-green-dim:rgba(45,138,0,.10);--sena-green-glow:rgba(45,138,0,.25);--accent-red:#dc2626;--accent-amber:#d97706;--card-shadow:0 2px 16px rgba(57,169,0,.10);}
        @if (!esAprendiz) {<text>
        /* Paleta morada — Funcionario en modo tienda */
        :root,[data-theme="dark"]{--sena-green:#7C3AED;--sena-green-dim:rgba(124,58,237,.15);--sena-green-glow:rgba(124,58,237,.35);}
        [data-theme="light"]{--bg-base:#f4f3ff;--text-primary:#1a1535;--text-secondary:#5b4fa8;--text-muted:#8a82b8;--sena-green:#6D28D9;--sena-green-dim:rgba(109,40,217,.10);--sena-green-glow:rgba(109,40,217,.25);--card-shadow:0 2px 16px rgba(109,40,217,.12);}
        </text>}
        *,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
        body{font-family:'Inter',sans-serif;background:var(--bg-base);color:var(--text-primary);min-height:100vh;overflow:hidden;transition:background .3s,color .3s;}
        h1,h2,h3,h4{font-family:'Outfit',sans-serif;}

        /* ── Topbar ── */
        .topbar{background:var(--bg-surface);border-bottom:1px solid var(--border);display:flex;align-items:center;padding:0 20px;gap:12px;height:62px;position:sticky;top:0;z-index:100;flex-shrink:0;}
        .topbar-logo{display:flex;align-items:center;gap:8px;font-family:'Outfit',sans-serif;font-size:1.1rem;font-weight:800;color:var(--sena-green);text-decoration:none;flex-shrink:0;}
        .topbar-divider{width:1px;height:22px;background:var(--border);flex-shrink:0;}
        .topbar-sede{font-size:.78rem;color:var(--text-secondary);font-weight:500;flex-shrink:0;max-width:180px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
        .topbar-spacer{flex:1;}
        .topbar-search{display:flex;align-items:center;gap:8px;background:var(--bg-input);border:1px solid var(--border);border-radius:10px;padding:0 12px;height:36px;flex:1;max-width:280px;transition:border-color .2s;}
        .topbar-search:focus-within{border-color:var(--sena-green);}
        .topbar-search input{background:none;border:none;outline:none;font-size:.82rem;color:var(--text-primary);width:100%;font-family:'Inter',sans-serif;}
        .topbar-search input::placeholder{color:var(--text-muted);}
        .topbar-search i{color:var(--text-muted);font-size:.9rem;flex-shrink:0;}
        .btn-theme,.btn-cart,.btn-back{width:38px;height:38px;border-radius:10px;border:1px solid var(--border);background:var(--bg-card);color:var(--text-secondary);cursor:pointer;display:flex;align-items:center;justify-content:center;font-size:1.05rem;transition:.2s;text-decoration:none;position:relative;flex-shrink:0;}
        .btn-theme:hover,.btn-cart:hover,.btn-back:hover{background:var(--sena-green-dim);color:var(--sena-green);border-color:var(--sena-green);}
        .cart-badge{position:absolute;top:-6px;right:-6px;background:var(--sena-green);color:#fff;font-size:.55rem;font-weight:700;min-width:18px;height:18px;border-radius:99px;display:flex;align-items:center;justify-content:center;padding:0 4px;font-family:'Outfit',sans-serif;}
        .cart-badge.hidden{display:none;}
        .topbar-avatar{width:36px;height:36px;border-radius:50%;background:var(--sena-green);color:#fff;font-family:'Outfit',sans-serif;font-weight:700;font-size:.8rem;display:flex;align-items:center;justify-content:center;flex-shrink:0;}

        /* ── Shell (sidebar + product area) ── */
        .catalog-shell{display:flex;height:calc(100vh - 62px);overflow:hidden;}

        /* ── Category sidebar ── */
        .cat-sidebar{width:200px;flex-shrink:0;background:var(--bg-surface);border-right:1px solid var(--border);padding:20px 14px;overflow-y:auto;display:flex;flex-direction:column;gap:4px;}
        .cat-label{font-size:.62rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--text-muted);padding:8px 10px 4px;}
        .cat-chip{display:flex;align-items:center;gap:8px;padding:9px 12px;border-radius:10px;font-size:.82rem;font-weight:500;color:var(--text-secondary);cursor:pointer;border:none;background:transparent;width:100%;text-align:left;transition:.15s;}
        .cat-chip:hover{background:var(--sena-green-dim);color:var(--sena-green);}
        .cat-chip.active{background:var(--sena-green-dim);color:var(--sena-green);font-weight:600;}
        .cat-chip i{font-size:.95rem;width:18px;text-align:center;}

        /* ── Product area ── */
        .product-area{flex:1;overflow-y:auto;padding:24px;}
        .product-area-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:20px;gap:12px;}
        .product-count{font-size:.8rem;color:var(--text-muted);}
        .product-count strong{color:var(--sena-green);font-family:'Outfit',sans-serif;font-size:.95rem;}

        /* ── Product grid ── */
        .product-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:18px;}

        /* ── Product card ── */
        .prod-card{background:var(--bg-card);border:1px solid var(--border);border-radius:18px;overflow:hidden;display:flex;flex-direction:column;transition:transform .2s,box-shadow .2s,border-color .2s;}
        .prod-card:hover{transform:translateY(-3px);box-shadow:0 10px 32px rgba(57,169,0,.12);border-color:var(--sena-green);}
        .prod-card.hidden{display:none;}
        .prod-card.unavailable{opacity:.55;}

        .prod-img-wrap{width:100%;aspect-ratio:4/3;background:var(--bg-input);position:relative;overflow:hidden;}
        .prod-img-wrap img{width:100%;height:100%;object-fit:cover;}
        .prod-img-placeholder{width:100%;height:100%;display:flex;align-items:center;justify-content:center;color:var(--text-muted);font-size:2.4rem;}
        .prod-cat-badge{position:absolute;top:10px;left:10px;background:rgba(0,0,0,.6);backdrop-filter:blur(4px);color:#fff;font-size:.62rem;font-weight:700;padding:3px 8px;border-radius:99px;font-family:'Outfit',sans-serif;}

        .prod-body{padding:14px;display:flex;flex-direction:column;gap:8px;flex:1;}
        .prod-name{font-family:'Outfit',sans-serif;font-size:.95rem;font-weight:700;color:var(--text-primary);line-height:1.3;}
        .prod-price{font-family:'Outfit',sans-serif;font-size:1.15rem;font-weight:800;color:var(--sena-green);}
        .stock-badge{display:inline-flex;align-items:center;gap:4px;font-size:.65rem;font-weight:700;padding:3px 8px;border-radius:99px;font-family:'Outfit',sans-serif;}
        .stock-ok{background:rgba(34,197,94,.1);color:#16a34a;}
        .badge-warning{background:rgba(245,158,11,.12);color:#d97706;}
        .badge-danger{background:rgba(239,68,68,.1);color:#ef4444;}
        .badge-off{background:rgba(100,116,139,.1);color:#64748b;}

        .btn-agregar{display:flex;align-items:center;justify-content:center;gap:6px;width:100%;padding:10px;border-radius:11px;background:var(--sena-green);color:#fff;font-family:'Outfit',sans-serif;font-size:.82rem;font-weight:700;border:none;cursor:pointer;transition:.2s;margin-top:auto;}
        .btn-agregar:hover:not(:disabled){background:#2d8a00;transform:translateY(-1px);}
        .btn-agregar:disabled{background:var(--bg-input);color:var(--text-muted);cursor:not-allowed;transform:none;}
        .btn-agregar.adding{opacity:.7;pointer-events:none;}

        /* ── Empty state ── */
        .empty-products{text-align:center;padding:64px 24px;color:var(--text-muted);grid-column:1/-1;}
        .empty-products i{font-size:2.8rem;display:block;margin-bottom:14px;color:var(--sena-green);opacity:.4;}
        .empty-products p{font-size:.9rem;}

        /* ── Cart drawer ── */
        .cart-backdrop{position:fixed;inset:0;background:rgba(0,0,0,.5);backdrop-filter:blur(3px);z-index:200;opacity:0;pointer-events:none;transition:opacity .25s;}
        .cart-backdrop.open{opacity:1;pointer-events:all;}
        .cart-drawer{position:fixed;top:0;right:0;height:100vh;width:380px;max-width:100vw;background:var(--bg-surface);border-left:1px solid var(--border);z-index:201;display:flex;flex-direction:column;transform:translateX(100%);transition:transform .3s cubic-bezier(.4,0,.2,1);box-shadow:-8px 0 48px rgba(0,0,0,.4);}
        .cart-drawer.open{transform:translateX(0);}

        .cart-header{display:flex;align-items:center;gap:12px;padding:20px 20px;border-bottom:1px solid var(--border);flex-shrink:0;}
        .cart-header-icon{width:38px;height:38px;border-radius:10px;background:var(--sena-green-dim);display:flex;align-items:center;justify-content:center;font-size:1.1rem;color:var(--sena-green);}
        .cart-header h3{font-family:'Outfit',sans-serif;font-size:.95rem;font-weight:700;color:var(--text-primary);}
        .cart-header-close{margin-left:auto;background:none;border:none;color:var(--text-muted);font-size:1.1rem;cursor:pointer;padding:6px;border-radius:8px;transition:background .15s;}
        .cart-header-close:hover{background:var(--border);}

        .cart-items{flex:1;overflow-y:auto;padding:16px 20px;display:flex;flex-direction:column;gap:12px;}

        .cart-item{display:flex;align-items:center;gap:12px;background:var(--bg-card);border:1px solid var(--border);border-radius:12px;padding:12px;}
        .cart-item-img{width:44px;height:44px;border-radius:8px;object-fit:cover;flex-shrink:0;background:var(--bg-input);}
        .cart-item-img-ph{width:44px;height:44px;border-radius:8px;background:var(--bg-input);display:flex;align-items:center;justify-content:center;color:var(--text-muted);font-size:1.1rem;flex-shrink:0;}
        .cart-item-info{flex:1;min-width:0;}
        .cart-item-name{font-family:'Outfit',sans-serif;font-size:.83rem;font-weight:600;color:var(--text-primary);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
        .cart-item-price{font-size:.75rem;color:var(--text-muted);margin-top:1px;}
        .cart-qty{display:flex;align-items:center;gap:4px;flex-shrink:0;}
        .btn-qty{width:26px;height:26px;border-radius:7px;border:1px solid var(--border);background:var(--bg-input);color:var(--text-secondary);cursor:pointer;display:flex;align-items:center;justify-content:center;font-size:.85rem;transition:.15s;}
        .btn-qty:hover{background:var(--sena-green-dim);color:var(--sena-green);border-color:var(--sena-green);}
        .qty-num{font-family:'Outfit',sans-serif;font-weight:700;font-size:.85rem;color:var(--text-primary);min-width:20px;text-align:center;}

        .cart-empty{text-align:center;padding:48px 20px;color:var(--text-muted);}
        .cart-empty i{font-size:2.4rem;display:block;margin-bottom:12px;opacity:.4;color:var(--sena-green);}
        .cart-empty p{font-size:.85rem;}

        .cart-footer{padding:16px 20px;border-top:1px solid var(--border);flex-shrink:0;display:flex;flex-direction:column;gap:10px;}
        .cart-subtotal{display:flex;align-items:center;justify-content:space-between;}
        .cart-subtotal-label{font-size:.8rem;color:var(--text-muted);}
        .cart-subtotal-value{font-family:'Outfit',sans-serif;font-size:1.1rem;font-weight:800;color:var(--text-primary);}
        .btn-checkout{display:flex;align-items:center;justify-content:center;gap:8px;width:100%;padding:13px;border-radius:12px;background:var(--sena-green);color:#fff;font-family:'Outfit',sans-serif;font-size:.92rem;font-weight:700;border:none;cursor:pointer;transition:.2s;box-shadow:0 4px 16px var(--sena-green-glow);}
        .btn-checkout:hover{background:#2d8a00;transform:translateY(-1px);}
        .btn-checkout:disabled{background:var(--bg-input);color:var(--text-muted);cursor:not-allowed;transform:none;box-shadow:none;}

        /* ── Checkout modal ── */
        .checkout-backdrop{position:fixed;inset:0;background:rgba(0,0,0,.7);backdrop-filter:blur(6px);z-index:300;display:none;align-items:center;justify-content:center;padding:16px;}
        .checkout-backdrop.open{display:flex;}
        .checkout-modal{background:var(--bg-surface);border:1px solid var(--border);border-radius:20px;width:100%;max-width:480px;max-height:90vh;overflow-y:auto;box-shadow:0 24px 64px rgba(0,0,0,.4);animation:modalIn .3s cubic-bezier(.34,1.2,.64,1);}
        @@keyframes modalIn{from{opacity:0;transform:scale(.95) translateY(10px);}to{opacity:1;transform:scale(1) translateY(0);}}

        .modal-header{display:flex;align-items:center;gap:12px;padding:20px 22px;border-bottom:1px solid var(--border);}
        .modal-header-icon{width:40px;height:40px;border-radius:11px;background:var(--sena-green-dim);display:flex;align-items:center;justify-content:center;font-size:1.1rem;color:var(--sena-green);flex-shrink:0;}
        .modal-header h3{font-family:'Outfit',sans-serif;font-size:.95rem;font-weight:700;color:var(--text-primary);}
        .modal-header p{font-size:.72rem;color:var(--text-muted);}
        .modal-close{margin-left:auto;background:none;border:none;color:var(--text-muted);font-size:1.1rem;cursor:pointer;padding:6px;border-radius:8px;transition:background .15s;}
        .modal-close:hover{background:var(--border);}
        .modal-body{padding:22px;}
        .modal-items-list{display:flex;flex-direction:column;gap:8px;margin-bottom:16px;}
        .modal-item{display:flex;align-items:center;justify-content:space-between;font-size:.83rem;padding:8px 12px;background:var(--bg-card);border-radius:10px;border:1px solid var(--border);}
        .modal-item-name{color:var(--text-secondary);font-weight:500;}
        .modal-item-price{font-family:'Outfit',sans-serif;font-weight:700;color:var(--text-primary);flex-shrink:0;}
        .modal-total-row{display:flex;align-items:center;justify-content:space-between;padding:12px 0;border-top:1px solid var(--border);margin-bottom:16px;}
        .modal-total-label{font-family:'Outfit',sans-serif;font-size:.85rem;font-weight:700;color:var(--text-primary);}
        .modal-total-value{font-family:'Outfit',sans-serif;font-size:1.3rem;font-weight:800;color:var(--sena-green);}

        .modal-section-label{font-size:.65rem;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:var(--text-muted);margin-bottom:8px;display:block;}
        .modal-datetime-wrap{display:flex;flex-direction:column;gap:10px;padding:14px;background:var(--bg-card);border:1px solid var(--border);border-radius:12px;margin-bottom:16px;}
        .modal-datetime-toggle{display:flex;align-items:center;gap:8px;cursor:pointer;user-select:none;}
        .modal-datetime-toggle input[type="checkbox"]{width:16px;height:16px;accent-color:var(--sena-green);cursor:pointer;}
        .modal-datetime-toggle span{font-size:.84rem;color:var(--text-secondary);font-weight:500;}
        .datetime-picker-row{display:none;flex-direction:column;gap:6px;}
        .datetime-picker-row.visible{display:flex;}
        .modal-input{width:100%;padding:10px 13px;border:1.5px solid var(--border);border-radius:10px;font-family:'Inter',sans-serif;font-size:.84rem;color:var(--text-primary);background:var(--bg-input);outline:none;transition:border-color .2s;color-scheme:dark;}
        .modal-input:focus{border-color:var(--sena-green);box-shadow:0 0 0 3px var(--sena-green-dim);}
        [data-theme="light"] .modal-input{color-scheme:light;}

        .modal-footer{display:flex;gap:10px;padding:16px 22px;border-top:1px solid var(--border);}
        .btn-cancel{flex:1;padding:11px;border-radius:10px;border:1.5px solid var(--border);background:transparent;color:var(--text-muted);font-family:'Outfit',sans-serif;font-size:.82rem;font-weight:600;cursor:pointer;transition:.2s;}
        .btn-cancel:hover{border-color:var(--sena-green);color:var(--sena-green);}
        .btn-pay{flex:2;display:flex;align-items:center;justify-content:center;gap:8px;padding:11px;border-radius:10px;background:var(--sena-green);color:#fff;font-family:'Outfit',sans-serif;font-size:.85rem;font-weight:700;border:none;cursor:pointer;transition:.2s;box-shadow:0 4px 14px var(--sena-green-glow);}
        .btn-pay:hover:not(:disabled){background:#2d8a00;transform:translateY(-1px);}
        .btn-pay:disabled{opacity:.6;cursor:not-allowed;transform:none;}

        /* ── Toast ── */
        #toastPanel{position:fixed;bottom:24px;right:24px;z-index:9999;background:var(--bg-card);border:1px solid var(--border);border-radius:14px;padding:14px 18px;display:flex;align-items:center;gap:12px;box-shadow:var(--card-shadow);transform:translateY(120px);opacity:0;transition:transform .35s cubic-bezier(.34,1.56,.64,1),opacity .3s;min-width:260px;max-width:360px;}

        @@media(max-width:900px){
            .cat-sidebar{display:none;}
            .cat-chips-mobile{display:flex;gap:8px;overflow-x:auto;padding:12px 16px;border-bottom:1px solid var(--border);background:var(--bg-surface);flex-shrink:0;-webkit-overflow-scrolling:touch;}
            .cat-chips-mobile .cat-chip{flex-shrink:0;background:var(--bg-card);border:1px solid var(--border);border-radius:99px;padding:6px 14px;white-space:nowrap;}
            .cat-chips-mobile .cat-chip.active{background:var(--sena-green-dim);border-color:var(--sena-green);color:var(--sena-green);}
            .catalog-shell{flex-direction:column;}
            .product-area{padding:16px;}
        }
        @@media(min-width:901px){.cat-chips-mobile{display:none;}}
        @@media(max-width:500px){.topbar-search{display:none;}.product-grid{grid-template-columns:1fr 1fr;}.cart-drawer{width:100vw;}}
    </style>
</head>
<body>

<header class="topbar">
    <a class="topbar-logo" href="#">
        <svg viewBox="0 0 44 44" fill="none" width="26" height="26">
            <circle cx="22" cy="22" r="22" fill="var(--sena-green)" fill-opacity=".12"/>
            <circle cx="22" cy="14" r="5" fill="var(--sena-green)"/>
            <path d="M10 34c0-6.627 5.373-12 12-12s12 5.373 12 12" stroke="var(--sena-green)" stroke-width="3" stroke-linecap="round" fill="none"/>
        </svg>
        SenaPay
    </a>
    <div class="topbar-divider"></div>
    <span class="topbar-sede" title="@sedeNombre">@sedeNombre</span>
    <div class="topbar-spacer"></div>
    <div class="topbar-search">
        <i class="bi bi-search"></i>
        <input type="text" id="searchInput" placeholder="Buscar producto..." autocomplete="off" />
    </div>
    <a class="btn-back" href="/Tienda" title="Cambiar sede">
        <i class="bi bi-arrow-left"></i>
    </a>
    <button class="btn-cart" id="btnCart" title="Ver carrito">
        <i class="bi bi-cart3"></i>
        <span class="cart-badge hidden" id="cartBadge">0</span>
    </button>
    <button class="btn-theme" id="btnTheme" title="Cambiar tema">
        <i class="bi bi-moon-fill" id="themeIcon"></i>
    </button>
    <div class="topbar-avatar">@iniciales</div>
</header>

<!-- Mobile category chips -->
<div class="cat-chips-mobile" id="mobileCatChips">
    <button class="cat-chip active" data-cat="">
        <i class="bi bi-grid-3x3-gap-fill"></i> Todos
    </button>
    @foreach (var cat in Model.Categorias)
    {
        <button class="cat-chip" data-cat="@cat">@cat</button>
    }
</div>

<div class="catalog-shell">

    <!-- ── Category sidebar ── -->
    <aside class="cat-sidebar" id="catSidebar">
        <span class="cat-label">Categorías</span>
        <button class="cat-chip active" data-cat="">
            <i class="bi bi-grid-3x3-gap-fill"></i> Todos
        </button>
        @foreach (var cat in Model.Categorias)
        {
            <button class="cat-chip" data-cat="@cat">
                <i class="bi bi-tag-fill"></i> @cat
            </button>
        }
    </aside>

    <!-- ── Product area ── -->
    <main class="product-area" id="productArea">
        <div class="product-area-header">
            <div class="product-count">
                <strong id="visibleCount">@Model.Productos.Count</strong>
                producto@(Model.Productos.Count != 1 ? "s" : "") en <em>@tiendaNombre</em>
            </div>
        </div>

        <div class="product-grid" id="productGrid">
            @if (!Model.Productos.Any())
            {
                <div class="empty-products">
                    <i class="bi bi-box-seam"></i>
                    <p>Esta tienda aún no tiene productos disponibles.</p>
                </div>
            }
            else
            {
                @foreach (var p in Model.Productos)
                {
                    <div class="prod-card @(p.Disponible ? "" : "unavailable")"
                         data-cat="@p.NombreCategoria"
                         data-nombre="@p.NombreProducto.ToLower()">
                        <div class="prod-img-wrap">
                            @if (!string.IsNullOrEmpty(p.Imagen))
                            {
                                <img src="@p.Imagen" alt="@p.NombreProducto" loading="lazy" />
                            }
                            else
                            {
                                <div class="prod-img-placeholder"><i class="bi bi-box-seam"></i></div>
                            }
                            @if (!string.IsNullOrEmpty(p.NombreCategoria))
                            {
                                <span class="prod-cat-badge">@p.NombreCategoria</span>
                            }
                        </div>
                        <div class="prod-body">
                            <div class="prod-name">@p.NombreProducto</div>
                            <div class="prod-price">$@p.Precio.ToString("N0", ci)</div>
                            <span class="stock-badge @p.StockCssClass">
                                <i class="bi @p.StockIconCss"></i>
                                @p.Stock uds · @p.StockLabel
                            </span>
                            <button class="btn-agregar"
                                    @(p.Disponible ? "" : "disabled")
                                    data-id="@p.IdProducto"
                                    data-tienda="@p.IdTienda"
                                    data-nombre="@Html.Raw(System.Text.Encodings.Web.HtmlEncoder.Default.Encode(p.NombreProducto))"
                                    data-precio="@p.Precio.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                    data-imagen="@(p.Imagen ?? "")"
                                    data-cat="@p.NombreCategoria">
                                <i class="bi bi-@(p.Disponible ? "cart-plus" : "x-circle")"></i>
                                @p.BtnLabel
                            </button>
                        </div>
                    </div>
                }
            }
        </div>
    </main>
</div>

<!-- ══════════════ CART DRAWER ══════════════ -->
<div class="cart-backdrop" id="cartBackdrop" onclick="closeCart()"></div>
<div class="cart-drawer" id="cartDrawer">
    <div class="cart-header">
        <div class="cart-header-icon"><i class="bi bi-cart3"></i></div>
        <div>
            <h3>Mi carrito</h3>
        </div>
        <button class="cart-header-close" onclick="closeCart()"><i class="bi bi-x-lg"></i></button>
    </div>

    <div class="cart-items" id="cartItems">
        <div class="cart-empty"><i class="bi bi-cart-x"></i><p>Tu carrito está vacío.</p></div>
    </div>

    <div class="cart-footer">
        <div class="cart-subtotal">
            <span class="cart-subtotal-label">Total</span>
            <span class="cart-subtotal-value" id="cartTotal">$0</span>
        </div>
        <button class="btn-checkout" id="btnCheckout" disabled onclick="openCheckout()">
            <i class="bi bi-credit-card-fill"></i> Proceder al pago
        </button>
    </div>
</div>

<!-- ══════════════ CHECKOUT MODAL ══════════════ -->
<div class="checkout-backdrop" id="checkoutBackdrop">
    <div class="checkout-modal">
        <div class="modal-header">
            <div class="modal-header-icon"><i class="bi bi-bag-check-fill"></i></div>
            <div>
                <h3>Confirmar @(esAprendiz ? "compra" : "pedido")</h3>
                <p>Revisa tu pedido antes de confirmar</p>
            </div>
            <button class="modal-close" onclick="closeCheckout()"><i class="bi bi-x-lg"></i></button>
        </div>
        <div class="modal-body">
            <span class="modal-section-label">Productos</span>
            <div class="modal-items-list" id="modalItemsList"></div>
            <div class="modal-total-row">
                <span class="modal-total-label">Total a pagar</span>
                <span class="modal-total-value" id="modalTotal">$0</span>
            </div>

            <!-- Reserva opcional -->
            <div class="modal-datetime-wrap">
                <label class="modal-datetime-toggle">
                    @if (esAprendiz)
                    {
                        <input type="checkbox" id="chkReserva" onchange="toggleDatePicker(this)" />
                        <span>¿Recoger en otra fecha/hora? (opcional)</span>
                    }
                    else
                    {
                        <input type="checkbox" id="chkReserva" onchange="toggleDatePicker(this)" />
                        <span>Seleccionar fecha y hora de recogida (opcional)</span>
                    }
                </label>
                <div class="datetime-picker-row" id="datePickerRow">
                    <span class="modal-section-label" style="margin-bottom:0;">Fecha y hora de recogida</span>
                    <input type="datetime-local" id="fechaReserva" class="modal-input" />
                </div>
            </div>

            @if (!esAprendiz)
            {
                <text>
                <!-- Scan comprador (solo Funcionario) -->
                <div style="margin-top:14px;">
                    <div style="font-size:.72rem;font-weight:700;text-transform:uppercase;letter-spacing:.05em;color:var(--text-muted);margin-bottom:6px;">
                        Escanear carnet del comprador (opcional)
                    </div>
                    <div style="display:flex;gap:8px;">
                        <input id="scanComprador" type="number"
                               style="flex:1;background:var(--card-bg);border:1.5px solid var(--border-color);border-radius:10px;padding:10px 14px;font-size:.9rem;color:var(--text-primary);font-family:'Courier New',monospace;outline:none;"
                               placeholder="Cédula del aprendiz..." autocomplete="off" />
                        <button onclick="verificarComprador()"
                                style="background:var(--sena-green);color:#fff;border:none;border-radius:10px;padding:10px 16px;font-weight:700;font-size:.85rem;cursor:pointer;">
                            <i class="bi bi-upc-scan"></i>
                        </button>
                    </div>
                    <div id="compradorInfo" style="display:none;margin-top:8px;background:var(--sena-green-dim);border-radius:10px;padding:10px 14px;font-size:.82rem;">
                        <i class="bi bi-person-check-fill" style="color:var(--sena-green);"></i>
                        <span id="compradorNombre" style="font-weight:700;color:var(--text-primary);"></span>
                        — Saldo: <strong id="compradorSaldo" style="color:var(--sena-green);"></strong>
                    </div>
                    <div id="compradorError" style="display:none;margin-top:8px;background:rgba(239,68,68,.1);border-radius:10px;padding:10px 14px;font-size:.82rem;color:#b91c1c;">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                        <span id="compradorErrorMsg"></span>
                    </div>
                </div>
                <div style="background:rgba(57,169,0,.08);border:1px solid var(--sena-green-dim);border-radius:10px;padding:10px 14px;font-size:.78rem;color:var(--text-secondary);margin-top:12px;">
                    <i class="bi bi-info-circle-fill" style="color:var(--sena-green);"></i>
                    Sin escanear: el pedido queda como reserva. Con escaneo: se cobra al saldo del aprendiz.
                </div>
                </text>
            }
        </div>
        <div class="modal-footer">
            <button class="btn-cancel" onclick="closeCheckout()">Cancelar</button>
            <button class="btn-pay" id="btnPay" onclick="realizarPago()">
                <i class="bi bi-check-lg"></i>
                <span id="btnPayLabel">@(esAprendiz ? "Pagar ahora" : "Confirmar pedido")</span>
            </button>
        </div>
    </div>
</div>

<!-- ══════════════ TOAST ══════════════ -->
<div id="toastPanel">
    <div id="toastIcon" style="width:36px;height:36px;border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:1.2rem;flex-shrink:0;">
        <i id="toastIco" class="bi bi-check2-circle"></i>
    </div>
    <div style="flex:1;min-width:0;">
        <div id="toastTitle" style="font-family:'Outfit',sans-serif;font-weight:700;font-size:.88rem;color:var(--text-primary);"></div>
        <div id="toastMsg" style="font-size:.78rem;color:var(--text-secondary);margin-top:2px;line-height:1.4;"></div>
    </div>
    <button onclick="hideToast()" style="background:none;border:none;color:var(--text-muted);cursor:pointer;font-size:1rem;padding:4px;flex-shrink:0;">
        <i class="bi bi-x"></i>
    </button>
</div>

<script>
    // ── Datos iniciales ──────────────────────────────────────────
    const ES_APRENDIZ = @(esAprendiz ? "true" : "false");
    let carrito = @Html.Raw(carritoJson);

    // ── Formato moneda COP ────────────────────────────────────────
    const cop = new Intl.NumberFormat('es-CO', { style: 'currency', currency: 'COP', minimumFractionDigits: 0 });

    // ── Theme toggle ──────────────────────────────────────────────
    (function () {
        var t = localStorage.getItem('sp-theme') ||
            (window.matchMedia('(prefers-color-scheme:dark)').matches ? 'dark' : 'light');
        document.documentElement.setAttribute('data-theme', t);
        var ico = document.getElementById('themeIcon');
        if (ico) ico.className = t === 'dark' ? 'bi bi-moon-fill' : 'bi bi-sun-fill';
    })();
    document.getElementById('btnTheme').addEventListener('click', function () {
        var h = document.documentElement;
        var n = h.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
        h.setAttribute('data-theme', n);
        localStorage.setItem('sp-theme', n);
        document.getElementById('themeIcon').className = n === 'dark' ? 'bi bi-moon-fill' : 'bi bi-sun-fill';
    });

    // ── Filtro por categoría ──────────────────────────────────────
    var catActiva = '';
    var busqueda = '';

    function setCategoria(cat, btn) {
        catActiva = cat;
        // Resaltar chip activo en sidebar y mobile
        document.querySelectorAll('.cat-chip').forEach(function (c) {
            c.classList.toggle('active', c.dataset.cat === cat);
        });
        filtrar();
    }

    document.querySelectorAll('.cat-chip').forEach(function (btn) {
        btn.addEventListener('click', function () { setCategoria(this.dataset.cat, this); });
    });

    document.getElementById('searchInput').addEventListener('input', function () {
        busqueda = this.value.toLowerCase().trim();
        filtrar();
    });

    function filtrar() {
        var cards = document.querySelectorAll('#productGrid .prod-card');
        var visibles = 0;
        cards.forEach(function (card) {
            var matchCat = !catActiva || card.dataset.cat === catActiva;
            var matchQ = !busqueda || card.dataset.nombre.includes(busqueda);
            var show = matchCat && matchQ;
            card.classList.toggle('hidden', !show);
            if (show) visibles++;
        });
        document.getElementById('visibleCount').textContent = visibles;
    }

    // ── Carrito ───────────────────────────────────────────────────
    function subtotalCarrito() {
        return carrito.reduce(function (s, i) { return s + i.precio * i.cantidad; }, 0);
    }

    function renderCarrito() {
        var container = document.getElementById('cartItems');
        var badge = document.getElementById('cartBadge');
        var total = document.getElementById('cartTotal');
        var btnCo = document.getElementById('btnCheckout');

        var totalItems = carrito.reduce(function (s, i) { return s + i.cantidad; }, 0);

        badge.textContent = totalItems;
        badge.classList.toggle('hidden', totalItems === 0);
        total.textContent = cop.format(subtotalCarrito());
        btnCo.disabled = carrito.length === 0;

        if (carrito.length === 0) {
            container.innerHTML = '<div class="cart-empty"><i class="bi bi-cart-x"></i><p>Tu carrito está vacío.</p></div>';
            return;
        }

        container.innerHTML = carrito.map(function (item) {
            var imgHtml = item.imagen
                ? '<img class="cart-item-img" src="' + item.imagen + '" alt="" />'
                : '<div class="cart-item-img-ph"><i class="bi bi-box-seam"></i></div>';
            return '<div class="cart-item" data-id="' + item.idProducto + '">' +
                imgHtml +
                '<div class="cart-item-info">' +
                '<div class="cart-item-name">' + escHtml(item.nombreProducto) + '</div>' +
                '<div class="cart-item-price">' + cop.format(item.precio) + ' c/u</div>' +
                '</div>' +
                '<div class="cart-qty">' +
                '<button class="btn-qty" onclick="cambiarCantidad(' + item.idProducto + ',-1)"><i class="bi bi-dash"></i></button>' +
                '<span class="qty-num">' + item.cantidad + '</span>' +
                '<button class="btn-qty" onclick="cambiarCantidad(' + item.idProducto + ',1)"><i class="bi bi-plus"></i></button>' +
                '</div>' +
                '</div>';
        }).join('');
    }

    async function agregarAlCarrito(btn) {
        if (btn.disabled || btn.classList.contains('adding')) return;
        btn.classList.add('adding');

        var payload = {
            idProducto: parseInt(btn.dataset.id),
            idTienda: parseInt(btn.dataset.tienda),
            nombreProducto: btn.dataset.nombre,
            precio: parseFloat(btn.dataset.precio),
            imagen: btn.dataset.imagen || null,
            nombreCategoria: btn.dataset.cat || ''
        };

        try {
            var res = await fetch('/Tienda/AgregarAlCarrito', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });
            var data = await res.json();
            if (data.ok) {
                carrito = data.items;
                renderCarrito();
                showToast('success', '¡Agregado!', payload.nombreProducto + ' se añadió al carrito.');
            } else {
                showToast('error', 'Error', data.msg || 'No se pudo agregar el producto.');
            }
        } catch {
            showToast('error', 'Error', 'Problema de conexión. Intenta de nuevo.');
        } finally {
            btn.classList.remove('adding');
        }
    }

    async function cambiarCantidad(idProducto, delta) {
        try {
            var res = await fetch('/Tienda/ActualizarCarrito', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ idProducto: idProducto, delta: delta })
            });
            var data = await res.json();
            if (data.ok) {
                carrito = data.items;
                renderCarrito();
            } else {
                showToast('error', 'Error', data.msg || 'No se pudo actualizar.');
            }
        } catch {
            showToast('error', 'Error', 'Problema de conexión.');
        }
    }

    // ── Botones agregar ───────────────────────────────────────────
    document.querySelectorAll('.btn-agregar').forEach(function (btn) {
        if (!btn.disabled) {
            btn.addEventListener('click', function () { agregarAlCarrito(this); });
        }
    });

    // ── Cart drawer ───────────────────────────────────────────────
    document.getElementById('btnCart').addEventListener('click', openCart);

    function openCart() {
        document.getElementById('cartDrawer').classList.add('open');
        document.getElementById('cartBackdrop').classList.add('open');
        document.body.style.overflow = 'hidden';
    }

    function closeCart() {
        document.getElementById('cartDrawer').classList.remove('open');
        document.getElementById('cartBackdrop').classList.remove('open');
        document.body.style.overflow = '';
    }

    // ── Checkout modal ────────────────────────────────────────────
    function openCheckout() {
        // Rellenar items del modal
        var list = document.getElementById('modalItemsList');
        list.innerHTML = carrito.map(function (i) {
            return '<div class="modal-item">' +
                '<span class="modal-item-name">' + escHtml(i.nombreProducto) + ' × ' + i.cantidad + '</span>' +
                '<span class="modal-item-price">' + cop.format(i.precio * i.cantidad) + '</span>' +
                '</div>';
        }).join('');
        document.getElementById('modalTotal').textContent = cop.format(subtotalCarrito());
        // Reset reserva
        document.getElementById('chkReserva').checked = false;
        document.getElementById('datePickerRow').classList.remove('visible');
        document.getElementById('fechaReserva').value = '';
        updatePayLabel();
        document.getElementById('checkoutBackdrop').classList.add('open');
    }

    function closeCheckout() {
        document.getElementById('checkoutBackdrop').classList.remove('open');
    }

    function toggleDatePicker(chk) {
        document.getElementById('datePickerRow').classList.toggle('visible', chk.checked);
        updatePayLabel();
    }

    function updatePayLabel() {
        var chk = document.getElementById('chkReserva').checked;
        var label = document.getElementById('btnPayLabel');
        if (ES_APRENDIZ) {
            label.textContent = chk ? 'Reservar' : 'Pagar ahora';
        } else {
            label.textContent = chk ? 'Confirmar reserva' : 'Confirmar pedido';
        }
    }

    var _documentoComprador = null;

    async function verificarComprador() {
        var doc = parseInt(document.getElementById('scanComprador').value);
        document.getElementById('compradorInfo').style.display = 'none';
        document.getElementById('compradorError').style.display = 'none';
        _documentoComprador = null;
        if (!doc) return;

        var res = await fetch('/Tienda/VerificarComprador?doc=' + doc);
        var data = await res.json();
        if (data.encontrado) {
            var cop = new Intl.NumberFormat('es-CO', { style: 'currency', currency: 'COP', maximumFractionDigits: 0 });
            document.getElementById('compradorNombre').textContent = data.nombre;
            document.getElementById('compradorSaldo').textContent = cop.format(data.saldo);
            document.getElementById('compradorInfo').style.display = 'block';
            _documentoComprador = doc;
        } else {
            document.getElementById('compradorErrorMsg').textContent = 'No se encontró el aprendiz con ese documento.';
            document.getElementById('compradorError').style.display = 'block';
        }
    }

    // Scan automático al presionar Enter en el campo
    document.addEventListener('DOMContentLoaded', function () {
        var sc = document.getElementById('scanComprador');
        if (sc) sc.addEventListener('keydown', function (e) {
            if (e.key === 'Enter') verificarComprador();
        });
    });

    async function realizarPago() {
        var btn = document.getElementById('btnPay');
        var chk = document.getElementById('chkReserva').checked;
        var fechaVal = document.getElementById('fechaReserva').value;

        if (chk && !fechaVal) {
            showToast('error', 'Fecha requerida', 'Selecciona la fecha y hora de recogida.');
            return;
        }

        btn.disabled = true;
        btn.innerHTML = '<i class="bi bi-hourglass-split"></i> Procesando...';

        var payload = {
            fechaReserva: chk && fechaVal ? fechaVal : null,
            documentoComprador: _documentoComprador ?? null
        };

        try {
            var res = await fetch('/Tienda/Pagar', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });
            var data = await res.json();

            if (data.ok) {
                carrito = [];
                renderCarrito();
                closeCheckout();
                closeCart();

                var titulo = data.esReserva ? '¡Reserva confirmada!' : '¡Compra exitosa!';
                showToast('success', titulo, data.mensaje);

                // Mostrar saldo restante (aprendiz propio o aprendiz escaneado)
                if (data.saldoRestante !== null && data.saldoRestante !== undefined) {
                    var cop = new Intl.NumberFormat('es-CO', { style: 'currency', currency: 'COP', maximumFractionDigits: 0 });
                    setTimeout(function () {
                        showToast('success', 'Saldo descontado', 'Saldo restante: ' + cop.format(data.saldoRestante));
                    }, 3200);
                }
                _documentoComprador = null;
            } else {
                showToast('error', 'No se pudo completar', data.mensaje || 'Inténtalo de nuevo.');
            }
        } catch {
            showToast('error', 'Error de conexión', 'No se pudo conectar con el servidor.');
        } finally {
            btn.disabled = false;
            document.getElementById('btnPayLabel').textContent = ES_APRENDIZ
                ? (document.getElementById('chkReserva').checked ? 'Reservar' : 'Pagar ahora')
                : (document.getElementById('chkReserva').checked ? 'Confirmar reserva' : 'Confirmar pedido');
            btn.innerHTML = '<i class="bi bi-check-lg"></i> <span id="btnPayLabel">' +
                (ES_APRENDIZ ? 'Pagar ahora' : 'Confirmar pedido') + '</span>';
        }
    }

    // Cerrar checkout al clic en backdrop
    document.getElementById('checkoutBackdrop').addEventListener('click', function (e) {
        if (e.target === this) closeCheckout();
    });

    // Cerrar con Escape
    document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') {
            closeCheckout();
            closeCart();
        }
    });

    // ── Toast ─────────────────────────────────────────────────────
    var toastTimer;
    function showToast(type, title, msg) {
        var panel = document.getElementById('toastPanel');
        var icon = document.getElementById('toastIcon');
        document.getElementById('toastTitle').textContent = title;
        document.getElementById('toastMsg').textContent = msg;
        var ok = type === 'success';
        icon.style.background = ok ? 'rgba(57,169,0,.15)' : 'rgba(239,68,68,.15)';
        icon.style.color = ok ? 'var(--sena-green)' : 'var(--accent-red)';
        document.getElementById('toastIco').className = ok ? 'bi bi-check2-circle' : 'bi bi-x-circle';
        panel.style.transform = 'translateY(0)';
        panel.style.opacity = '1';
        clearTimeout(toastTimer);
        toastTimer = setTimeout(hideToast, 4500);
    }
    function hideToast() {
        var panel = document.getElementById('toastPanel');
        panel.style.transform = 'translateY(120px)';
        panel.style.opacity = '0';
    }

    // ── Escape HTML ───────────────────────────────────────────────
    function escHtml(str) {
        return String(str)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;');
    }

    // ── Inicializar carrito desde sesión ──────────────────────────
    renderCarrito();
</script>
</body>
</html>
