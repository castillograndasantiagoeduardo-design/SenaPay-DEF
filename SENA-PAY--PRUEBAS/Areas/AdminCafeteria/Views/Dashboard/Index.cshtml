@model SenaPay.Application.DTOs.Dashboard.DashboardTiendaDto
@{
    ViewData["Title"] = "Mi Tienda";
    ViewData["Breadcrumb"] = "Dashboard";
    Layout = "~/Areas/AdminCafeteria/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <style>
        /* ── Store Header ── */
        .store-header {
            display: flex;
            align-items: center;
            gap: 20px;
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 20px;
            padding: 24px 28px;
            margin-bottom: 24px;
            animation: slideUp .5s cubic-bezier(.22,1,.36,1) both;
            position: relative;
            overflow: hidden;
        }

        .store-header::before {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0;
            height: 3px;
            background: linear-gradient(90deg, var(--c), #fb923c);
            border-radius: 20px 20px 0 0;
        }

        .store-avatar-lg {
            width: 60px;
            height: 60px;
            border-radius: 16px;
            background: linear-gradient(135deg, var(--c), #fb923c);
            display: grid;
            place-items: center;
            font-size: 26px;
            color: #fff;
            flex-shrink: 0;
            box-shadow: 0 8px 24px rgba(232,108,0,.3);
        }

        .store-info-main { flex: 1; }

        .store-name-lg {
            font-family: 'Outfit', sans-serif;
            font-size: 1.35rem;
            font-weight: 800;
            color: var(--text-main);
            letter-spacing: -.3px;
            margin-bottom: 4px;
        }

        .store-meta {
            display: flex;
            align-items: center;
            gap: 14px;
            flex-wrap: wrap;
        }

        .store-meta-item {
            display: flex;
            align-items: center;
            gap: 5px;
            font-size: .76rem;
            color: var(--text-muted);
        }

        .store-meta-item i { color: var(--c); font-size: 13px; }

        .store-badge {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 5px 12px;
            border-radius: 99px;
            background: rgba(232,108,0,.1);
            border: 1px solid rgba(232,108,0,.2);
            color: var(--c);
            font-size: .68rem;
            font-weight: 700;
            font-family: 'Outfit', sans-serif;
            letter-spacing: .5px;
        }

        /* ── Onboarding Banner ── */
        .onboarding-banner {
            display: flex;
            align-items: center;
            gap: 18px;
            background: linear-gradient(135deg, rgba(232,108,0,.08), rgba(251,146,60,.04));
            border: 1.5px dashed rgba(232,108,0,.35);
            border-radius: 16px;
            padding: 20px 24px;
            margin-bottom: 28px;
            animation: slideUp .55s cubic-bezier(.22,1,.36,1) .05s both;
        }

        .onboarding-icon {
            width: 48px;
            height: 48px;
            border-radius: 14px;
            background: rgba(232,108,0,.12);
            display: grid;
            place-items: center;
            font-size: 22px;
            flex-shrink: 0;
        }

        .onboarding-text h3 {
            font-family: 'Outfit', sans-serif;
            font-size: .95rem;
            font-weight: 700;
            color: var(--c);
            margin-bottom: 4px;
        }

        .onboarding-text p {
            font-size: .78rem;
            color: var(--text-muted);
            line-height: 1.5;
            margin-bottom: 10px;
        }

        .btn-onboarding {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 9px 20px;
            border-radius: 10px;
            background: var(--c);
            color: #fff;
            font-family: 'Outfit', sans-serif;
            font-size: .78rem;
            font-weight: 700;
            letter-spacing: .5px;
            text-decoration: none;
            transition: background .2s, transform .15s;
            box-shadow: 0 4px 14px rgba(232,108,0,.3);
        }

        .btn-onboarding:hover {
            background: var(--cd);
            transform: translateY(-1px);
            color: #fff;
        }

        /* ── KPI Cards ── */
        .kpi-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 16px;
            margin-bottom: 28px;
            animation: slideUp .6s cubic-bezier(.22,1,.36,1) .08s both;
        }

        .kpi-card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 18px;
            padding: 20px;
            display: flex;
            flex-direction: column;
            gap: 6px;
            transition: transform .2s, box-shadow .2s;
            position: relative;
            overflow: hidden;
        }

        .kpi-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 28px rgba(0,0,0,.08);
        }

        .kpi-card-accent::after {
            content: '';
            position: absolute;
            bottom: 0; left: 0; right: 0;
            height: 2px;
            background: linear-gradient(90deg, var(--c), #fb923c);
            border-radius: 0 0 18px 18px;
        }

        .kpi-icon {
            width: 38px;
            height: 38px;
            border-radius: 11px;
            display: grid;
            place-items: center;
            font-size: 17px;
            margin-bottom: 6px;
        }

        .kpi-icon.amber   { background: rgba(232,108,0,.12); color: var(--c); }
        .kpi-icon.green   { background: rgba(34,197,94,.1);  color: #16a34a; }
        .kpi-icon.blue    { background: rgba(59,130,246,.1); color: #2563eb; }
        .kpi-icon.red     { background: rgba(239,68,68,.1);  color: #ef4444; }

        .kpi-value {
            font-family: 'Outfit', sans-serif;
            font-size: 1.65rem;
            font-weight: 800;
            color: var(--text-main);
            line-height: 1;
        }

        .kpi-value.amber { color: var(--c); }
        .kpi-value.green { color: #16a34a; }
        .kpi-value.red   { color: #ef4444; }

        .kpi-label {
            font-size: .7rem;
            color: var(--text-muted);
            font-weight: 500;
        }

        .kpi-sub {
            font-size: .67rem;
            color: var(--text-muted);
            display: flex;
            align-items: center;
            gap: 4px;
            margin-top: 2px;
        }

        /* ── Quick actions ── */
        .quick-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 14px;
            animation: slideUp .65s cubic-bezier(.22,1,.36,1) .12s both;
        }

        .quick-card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 16px;
            padding: 20px;
            display: flex;
            align-items: center;
            gap: 14px;
            cursor: pointer;
            text-decoration: none;
            transition: all .2s;
        }

        .quick-card:hover {
            border-color: var(--c);
            background: rgba(232,108,0,.04);
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(232,108,0,.1);
        }

        .quick-icon {
            width: 44px;
            height: 44px;
            border-radius: 12px;
            background: rgba(232,108,0,.1);
            display: grid;
            place-items: center;
            font-size: 20px;
            color: var(--c);
            flex-shrink: 0;
            transition: background .2s;
        }

        .quick-card:hover .quick-icon { background: rgba(232,108,0,.18); }

        .quick-title {
            font-family: 'Outfit', sans-serif;
            font-size: .85rem;
            font-weight: 700;
            color: var(--text-main);
            margin-bottom: 2px;
        }

        .quick-sub {
            font-size: .7rem;
            color: var(--text-muted);
        }

        .quick-arrow {
            margin-left: auto;
            color: var(--text-muted);
            font-size: 14px;
            transition: transform .2s, color .2s;
        }

        .quick-card:hover .quick-arrow {
            transform: translateX(3px);
            color: var(--c);
        }

        @@media (max-width: 992px) {
            .kpi-grid { grid-template-columns: repeat(2, 1fr); }
            .quick-grid { grid-template-columns: 1fr; }
        }

        @@media (max-width: 576px) {
            .kpi-grid { grid-template-columns: 1fr 1fr; }
            .store-header { flex-direction: column; align-items: flex-start; gap: 12px; }
        }
    </style>
}

<!-- ── Store Header ─────────────────────────────── -->
<div class="store-header">
    <div class="store-avatar-lg"><i class="bi bi-shop-window"></i></div>
    <div class="store-info-main">
        <div class="store-name-lg">@Model.NombreTienda</div>
        <div class="store-meta">
            <div class="store-meta-item">
                <i class="bi bi-geo-alt-fill"></i>
                <span>@Model.Ubicacion</span>
            </div>
            <div class="store-meta-item">
                <i class="bi bi-building"></i>
                <span>@Model.NombreSede · @Model.CiudadSede</span>
            </div>
            <div class="store-meta-item">
                <i class="bi bi-person-fill"></i>
                <span>@Model.NombreAdmin</span>
            </div>
        </div>
    </div>
    <div class="store-badge">
        <i class="bi bi-patch-check-fill"></i>
        ADMIN TIENDA
    </div>
</div>

<!-- ── Onboarding (solo si no tiene categorías) ── -->
@if (!Model.TieneCategorias)
{
    <div class="onboarding-banner">
        <div class="onboarding-icon">🏷️</div>
        <div class="onboarding-text">
            <h3>¡Configura tu tienda antes de empezar!</h3>
            <p>
                Selecciona las categorías de productos que manejarás en <strong>@Model.NombreTienda</strong>.
                Sin categorías no podrás agregar productos al inventario.
            </p>
            <a asp-area="AdminCafeteria"
               asp-controller="Dashboard"
               asp-action="SeleccionarCategorias"
               class="btn-onboarding">
                <i class="bi bi-tags-fill"></i>
                Seleccionar categorías ahora
                <i class="bi bi-arrow-right"></i>
            </a>
        </div>
    </div>
}

<!-- ── KPI Cards ─────────────────────────────────── -->
<div class="kpi-grid">
    <div class="kpi-card kpi-card-accent">
        <div class="kpi-icon amber"><i class="bi bi-currency-dollar"></i></div>
        <div class="kpi-value amber">@Model.VentasHoy.ToString("C0")</div>
        <div class="kpi-label">Ventas hoy</div>
        <div class="kpi-sub"><i class="bi bi-dash"></i> Sin datos aún</div>
    </div>

    <div class="kpi-card">
        <div class="kpi-icon green"><i class="bi bi-wallet2"></i></div>
        <div class="kpi-value green">@Model.TotalIngresos.ToString("C0")</div>
        <div class="kpi-label">Ingresos totales</div>
        <div class="kpi-sub"><i class="bi bi-arrow-up-circle"></i> Acumulado histórico</div>
    </div>

    <div class="kpi-card">
        <div class="kpi-icon blue"><i class="bi bi-receipt"></i></div>
        <div class="kpi-value">@Model.TransaccionesHoy</div>
        <div class="kpi-label">Transacciones hoy</div>
        <div class="kpi-sub">
            @if (Model.TransaccionesHoy > 0)
            {
                <i class="bi bi-check-circle" style="color:#16a34a"></i>
                <span style="color:#16a34a">Activo hoy</span>
            }
            else
            {
                <i class="bi bi-dash"></i>
                <span>Sin movimiento hoy</span>
            }
        </div>
    </div>

    <div class="kpi-card">
        <div class="kpi-icon red"><i class="bi bi-exclamation-triangle-fill"></i></div>
        <div class="kpi-value @(Model.ProductosBajoStock > 0 ? "red" : "")">
            @Model.ProductosBajoStock
        </div>
        <div class="kpi-label">Productos bajo stock</div>
        <div class="kpi-sub">
            @if (Model.ProductosBajoStock > 0)
            {
                <i class="bi bi-exclamation-circle" style="color:#ef4444"></i>
                <span style="color:#ef4444">Requieren atención</span>
            }
            else
            {
                <i class="bi bi-check-circle" style="color:#16a34a"></i>
                <span style="color:#16a34a">Todo en orden</span>
            }
        </div>
    </div>
</div>

<!-- ── Accesos rápidos ────────────────────────────── -->
<div class="section-header" style="margin-bottom:16px; animation: slideUp .6s cubic-bezier(.22,1,.36,1) .1s both;">
    <div class="section-icon"><i class="bi bi-lightning-fill"></i></div>
    <div>
        <div class="section-title">Accesos rápidos</div>
        <div class="section-sub">Gestiona tu tienda desde aquí</div>
    </div>
</div>

<div class="quick-grid">
    <a asp-area="AdminCafeteria" asp-controller="Inventario" asp-action="Index" class="quick-card">
        <div class="quick-icon"><i class="bi bi-box-seam-fill"></i></div>
        <div>
            <div class="quick-title">Inventario</div>
            <div class="quick-sub">Ver y gestionar productos</div>
        </div>
        <i class="bi bi-chevron-right quick-arrow"></i>
    </a>

    <a asp-area="AdminCafeteria" asp-controller="Categorias" asp-action="Index" class="quick-card">
        <div class="quick-icon"><i class="bi bi-tags-fill"></i></div>
        <div>
            <div class="quick-title">Categorías</div>
            <div class="quick-sub">Habilitar o deshabilitar categorías</div>
        </div>
        <i class="bi bi-chevron-right quick-arrow"></i>
    </a>

    <a asp-area="AdminCafeteria" asp-controller="Ventas" asp-action="Index" class="quick-card">
        <div class="quick-icon"><i class="bi bi-receipt"></i></div>
        <div>
            <div class="quick-title">Mis Ventas</div>
            <div class="quick-sub">Historial de transacciones</div>
        </div>
        <i class="bi bi-chevron-right quick-arrow"></i>
    </a>

    <a asp-area="AdminCafeteria" asp-controller="Reservas" asp-action="Index" class="quick-card">
        <div class="quick-icon"><i class="bi bi-calendar-check-fill"></i></div>
        <div>
            <div class="quick-title">Reservas</div>
            <div class="quick-sub">Pedidos programados para recoger</div>
        </div>
        <i class="bi bi-chevron-right quick-arrow"></i>
    </a>
</div>
