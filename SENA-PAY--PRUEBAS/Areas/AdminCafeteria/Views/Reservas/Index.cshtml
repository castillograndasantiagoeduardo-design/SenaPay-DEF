@using SenaPay.Application.DTOs.Venta
@{
    ViewData["Title"] = "Reservas";
    ViewData["Breadcrumb"] = "Reservas";
    Layout = "~/Areas/AdminCafeteria/Views/Shared/_Layout.cshtml";

    var reservas = (ViewBag.Reservas as List<ReservaTiendaDto>) ?? new();
    var ci = new System.Globalization.CultureInfo("es-CO");
}

@section Styles {
<style>
    .inv-header { display:flex; align-items:center; justify-content:space-between; margin-bottom:24px; flex-wrap:wrap; gap:12px; animation:slideUp .5s cubic-bezier(.22,1,.36,1) both; }
    .inv-title  { font-family:'Outfit',sans-serif; font-size:1.35rem; font-weight:800; color:var(--text-main); }
    .inv-sub    { font-size:.75rem; color:var(--text-muted); margin-top:2px; }
    .inv-card   { background:var(--surface); border:1px solid var(--border); border-radius:20px; overflow:hidden; animation:slideUp .6s cubic-bezier(.22,1,.36,1) .06s both; }
    .inv-card-header { display:flex; align-items:center; justify-content:space-between; padding:18px 24px; border-bottom:1px solid var(--border); }
    .inv-count  { font-family:'Outfit',sans-serif; font-size:.8rem; font-weight:600; color:var(--text-muted); }
    .inv-count span { color:var(--c); font-size:1rem; font-weight:800; }
    .table-scroll { overflow-x:auto; }
    table.inv-table { width:100%; border-collapse:collapse; }
    table.inv-table th { padding:11px 16px; font-size:.72rem; font-weight:700; text-transform:uppercase; letter-spacing:.05em; color:var(--text-muted); text-align:left; background:var(--surface); border-bottom:1px solid var(--border); white-space:nowrap; }
    table.inv-table td { padding:14px 16px; font-size:.85rem; color:var(--text-main); border-bottom:1px solid var(--border); vertical-align:middle; }
    table.inv-table tbody tr:last-child td { border-bottom:none; }
    table.inv-table tbody tr:hover td { background:rgba(232,108,0,.03); }
    .badge { display:inline-flex; align-items:center; gap:4px; padding:4px 10px; border-radius:99px; font-size:.68rem; font-weight:700; font-family:'Outfit',sans-serif; white-space:nowrap; }
    .badge-ok      { background:rgba(34,197,94,.1);   color:#16a34a; }
    .badge-warning { background:rgba(245,158,11,.12); color:#d97706; }
    .badge-danger  { background:rgba(239,68,68,.1);   color:#ef4444; }
    .badge-muted   { background:rgba(100,116,139,.1); color:#64748b; }
    .venta-items { font-size:.78rem; color:var(--text-muted); line-height:1.6; }
    .total-col { font-family:'Outfit',sans-serif; font-weight:800; color:var(--c); white-space:nowrap; }
    .empty-state { text-align:center; padding:56px 24px; color:var(--text-muted); }
    .empty-state i { font-size:2.5rem; margin-bottom:12px; display:block; }

    .estado-form { display:inline-flex; gap:6px; align-items:center; }
    .btn-estado {
        border:none; border-radius:8px; padding:5px 11px;
        font-size:.7rem; font-weight:700; cursor:pointer;
        font-family:'Outfit',sans-serif; transition:opacity .2s, transform .15s;
    }
    .btn-estado:hover { opacity:.85; transform:translateY(-1px); }
    .btn-entregar { background:rgba(34,197,94,.12); color:#16a34a; }
    .btn-cancelar { background:rgba(239,68,68,.1);  color:#ef4444; }
    .btn-reabrir  { background:rgba(245,158,11,.12); color:#d97706; }
</style>
}

<div class="inv-header">
    <div>
        <div class="inv-title">Reservas</div>
        <div class="inv-sub">Pedidos reservados por aprendices en tu tienda</div>
    </div>
</div>

<div class="inv-card">
    <div class="inv-card-header">
        <span class="inv-count">Total: <span>@reservas.Count</span> reserva(s)</span>
    </div>
    <div class="table-scroll">
        @if (!reservas.Any())
        {
            <div class="empty-state">
                <i class="bi bi-calendar-check"></i>
                <p>No hay reservas registradas aún.</p>
            </div>
        }
        else
        {
            <table class="inv-table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Aprendiz</th>
                        <th>Cédula</th>
                        <th>Fecha reserva</th>
                        <th>Retiro</th>
                        <th>Productos</th>
                        <th>Total</th>
                        <th>Estado</th>
                        <th>Acción</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in reservas)
                    {
                        <tr>
                            <td><span class="badge badge-muted">#@r.IdTransaccion</span></td>
                            <td style="font-weight:600;">@r.NombreComprador</td>
                            <td style="font-family:'Courier New',monospace;font-size:.8rem;">@r.Documento</td>
                            <td style="white-space:nowrap;">
                                @r.FechaCreacion.ToString("dd/MM/yyyy")
                                <div style="font-size:.72rem;color:var(--text-muted);">@r.FechaCreacion.ToString("HH:mm")</div>
                            </td>
                            <td style="white-space:nowrap;">
                                @if (r.FechaRetiro.HasValue)
                                {
                                    @r.FechaRetiro.Value.ToString("dd/MM/yyyy")
                                    <div style="font-size:.72rem;color:var(--c);font-weight:700;">@r.FechaRetiro.Value.ToString("HH:mm")</div>
                                }
                                else
                                {
                                    <span style="color:var(--text-muted)">—</span>
                                }
                            </td>
                            <td>
                                @foreach (var item in r.Items)
                                {
                                    <div class="venta-items">
                                        @item.NombreProducto &times; @item.Cantidad
                                        <span style="color:var(--text-main);font-weight:600;">
                                            — $@item.PrecioUnitario.ToString("N0", ci)
                                        </span>
                                    </div>
                                }
                            </td>
                            <td class="total-col">$@r.Total.ToString("N0", ci)</td>
                            <td>
                                @{
                                    var (badgeClass, badgeIcon) = r.EstadoReserva switch {
                                        "Entregada" => ("badge-ok",      "bi-check-circle-fill"),
                                        "Cancelada" => ("badge-danger",  "bi-x-circle-fill"),
                                        _           => ("badge-warning", "bi-clock-fill")
                                    };
                                }
                                <span class="badge @badgeClass">
                                    <i class="bi @badgeIcon"></i> @r.EstadoReserva
                                </span>
                            </td>
                            <td>
                                @if (r.EstadoReserva == "Pendiente")
                                {
                                    <div class="estado-form">
                                        <form asp-area="AdminCafeteria" asp-controller="Reservas" asp-action="CambiarEstado" method="post" style="display:inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="idTransaccion" value="@r.IdTransaccion" />
                                            <input type="hidden" name="estado" value="Entregada" />
                                            <button type="submit" class="btn-estado btn-entregar">
                                                <i class="bi bi-check2"></i> Entregar
                                            </button>
                                        </form>
                                        <form asp-area="AdminCafeteria" asp-controller="Reservas" asp-action="CambiarEstado" method="post" style="display:inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="idTransaccion" value="@r.IdTransaccion" />
                                            <input type="hidden" name="estado" value="Cancelada" />
                                            <button type="submit" class="btn-estado btn-cancelar"
                                                    onclick="return confirm('¿Cancelar la reserva #@r.IdTransaccion?')">
                                                <i class="bi bi-x-lg"></i> Cancelar
                                            </button>
                                        </form>
                                    </div>
                                }
                                else if (r.EstadoReserva == "Cancelada")
                                {
                                    <form asp-area="AdminCafeteria" asp-controller="Reservas" asp-action="CambiarEstado" method="post" style="display:inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="idTransaccion" value="@r.IdTransaccion" />
                                        <input type="hidden" name="estado" value="Pendiente" />
                                        <button type="submit" class="btn-estado btn-reabrir">
                                            <i class="bi bi-arrow-counterclockwise"></i> Reabrir
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <span style="font-size:.75rem;color:var(--text-muted)">—</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>
