@using SenaPay.Application.DTOs.Funcionario
@model PerfilFuncionarioDto
@{
    Layout = null;
    var iniciales = string.Join("", Model.Nombre.Split(' ')
        .Where(p => p.Length > 0).Take(2)
        .Select(p => p[0].ToString().ToUpper()));
}
<!DOCTYPE html>
<html lang="es" data-theme="dark">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>SenaPay · Mi Carnet</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
    <script>(function(){var t=localStorage.getItem('sp-theme');if(t)document.documentElement.setAttribute('data-theme',t);})();</script>
    <style>
        :root,[data-theme="dark"]{
            --bg-base:#0d0d18;--bg-surface:#13131f;--bg-card:#1a1a2e;--bg-input:#1e1e30;
            --border:rgba(255,255,255,.07);--border-strong:rgba(255,255,255,.14);
            --text-primary:#e8eaf0;--text-secondary:#94a3b8;--text-muted:#5a6478;
            --accent:#7C3AED;--accent-dim:rgba(124,58,237,.15);--accent-glow:rgba(124,58,237,.35);
            --accent-dark:#6D28D9;
            --accent-red:#ef4444;--accent-amber:#f59e0b;
            --card-shadow:0 4px 24px rgba(0,0,0,.45);
            --carnet-from:#1a1035;--carnet-to:#0d0820;
        }
        [data-theme="light"]{
            --bg-base:#f4f3ff;--bg-surface:#fff;--bg-card:#fff;--bg-input:#f0eeff;
            --border:rgba(0,0,0,.08);--border-strong:rgba(0,0,0,.15);
            --text-primary:#1a1535;--text-secondary:#5b4fa8;--text-muted:#8a82b8;
            --accent:#6D28D9;--accent-dim:rgba(109,40,217,.10);--accent-glow:rgba(109,40,217,.25);
            --accent-dark:#5B21B6;
            --accent-red:#dc2626;--accent-amber:#d97706;
            --card-shadow:0 2px 16px rgba(109,40,217,.10);
            --carnet-from:#ede9fe;--carnet-to:#ddd6fe;
        }
        *,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
        body{font-family:'Inter',sans-serif;background:var(--bg-base);color:var(--text-primary);min-height:100vh;transition:background .3s,color .3s;}
        h1,h2,h3,h4,h5{font-family:'Outfit',sans-serif;}

        .shell{display:grid;grid-template-columns:240px 1fr;grid-template-rows:64px 1fr;min-height:100vh;}

        /* Topbar */
        .topbar{grid-column:1/-1;background:var(--bg-surface);border-bottom:1px solid var(--border);
                display:flex;align-items:center;padding:0 24px;gap:16px;position:sticky;top:0;z-index:100;}
        .topbar-logo{font-family:'Outfit',sans-serif;font-size:1.2rem;font-weight:700;color:var(--accent);text-decoration:none;}
        .topbar-divider{width:1px;height:24px;background:var(--border);}
        .topbar-title{font-size:.85rem;font-weight:500;color:var(--text-secondary);}
        .topbar-spacer{flex:1;}
        .btn-theme{width:38px;height:38px;border-radius:10px;border:1px solid var(--border);
                   background:var(--bg-card);color:var(--text-secondary);cursor:pointer;
                   display:flex;align-items:center;justify-content:center;font-size:1.1rem;
                   transition:background .2s,color .2s,border-color .2s;}
        .btn-theme:hover{background:var(--accent-dim);color:var(--accent);border-color:var(--accent);}
        .topbar-avatar{width:36px;height:36px;border-radius:50%;background:var(--accent);
                       color:#fff;font-family:'Outfit',sans-serif;font-weight:700;font-size:.8rem;
                       display:flex;align-items:center;justify-content:center;flex-shrink:0;}

        /* Sidebar */
        .sidebar{background:var(--bg-surface);border-right:1px solid var(--border);
                 padding:24px 16px;display:flex;flex-direction:column;gap:4px;
                 position:sticky;top:64px;height:calc(100vh - 64px);overflow-y:auto;}
        .nav-label{font-size:.65rem;font-weight:600;letter-spacing:.08em;text-transform:uppercase;
                   color:var(--text-muted);padding:12px 12px 6px;}
        .nav-item{display:flex;align-items:center;gap:10px;padding:10px 12px;border-radius:10px;
                  font-size:.875rem;font-weight:500;color:var(--text-secondary);cursor:pointer;
                  border:none;background:transparent;width:100%;text-align:left;text-decoration:none;
                  transition:background .15s,color .15s;}
        .nav-item:hover{background:var(--accent-dim);color:var(--accent);}
        .nav-item.active{background:var(--accent-dim);color:var(--accent);font-weight:600;}
        .nav-item i{font-size:1.05rem;width:20px;text-align:center;}
        .sidebar-bottom{margin-top:auto;padding-top:16px;border-top:1px solid var(--border);}
        .user-chip{display:flex;align-items:center;gap:10px;padding:8px 10px;border-radius:10px;
                   background:var(--accent-dim);}
        .chip-avatar{width:32px;height:32px;border-radius:50%;background:var(--accent);
                     color:#fff;font-family:'Outfit',sans-serif;font-weight:700;font-size:.75rem;
                     display:flex;align-items:center;justify-content:center;flex-shrink:0;}
        .chip-name{font-size:.8rem;font-weight:600;color:var(--text-primary);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
        .chip-role{font-size:.7rem;color:var(--accent);font-weight:500;}

        /* Main */
        .main{padding:28px 32px;overflow-y:auto;display:flex;flex-direction:column;gap:24px;}
        .page-header h2{font-size:1.4rem;font-weight:700;}
        .page-header p{font-size:.85rem;color:var(--text-secondary);margin-top:2px;}
        .dash-grid{display:grid;grid-template-columns:340px 1fr;gap:20px;align-items:start;}
        .card{background:var(--bg-card);border:1px solid var(--border);border-radius:16px;
              padding:24px;box-shadow:var(--card-shadow);}
        .card-title{font-size:1rem;font-weight:600;margin-bottom:16px;display:flex;align-items:center;gap:8px;}
        .card-title i{color:var(--accent);}

        /* Carnet */
        .carnet-wrap{perspective:1000px;}
        .carnet{background:linear-gradient(145deg,var(--carnet-from),var(--carnet-to));
                border:1px solid var(--accent);border-radius:18px;padding:0;
                box-shadow:0 0 0 1px var(--accent-glow),0 8px 32px rgba(124,58,237,.15),var(--card-shadow);
                overflow:hidden;transition:transform .4s ease,box-shadow .4s ease;
                transform-style:preserve-3d;position:relative;}
        .carnet:hover{transform:rotateY(-4deg) rotateX(2deg) translateZ(8px);
                      box-shadow:0 0 0 1px var(--accent-glow),0 16px 48px rgba(124,58,237,.25),var(--card-shadow);}
        .carnet-header{background:var(--accent);padding:12px 20px;display:flex;align-items:center;justify-content:space-between;}
        .carnet-logo-text{font-family:'Outfit',sans-serif;font-size:1.6rem;font-weight:800;color:#fff;letter-spacing:.05em;}
        .carnet-header-badge{font-size:.7rem;font-weight:700;color:rgba(255,255,255,.8);
                              background:rgba(255,255,255,.15);border-radius:20px;padding:4px 10px;letter-spacing:.05em;text-transform:uppercase;}
        .carnet-body{padding:20px;display:flex;flex-direction:column;gap:14px;}
        .carnet-top{display:flex;gap:16px;align-items:flex-start;}
        .carnet-photo{width:72px;height:72px;border-radius:14px;background:var(--accent-dim);
                      border:2px solid var(--accent);display:flex;align-items:center;justify-content:center;
                      font-family:'Outfit',sans-serif;font-weight:800;font-size:1.5rem;color:var(--accent);flex-shrink:0;}
        .carnet-info{flex:1;min-width:0;}
        .carnet-name{font-family:'Outfit',sans-serif;font-size:1.1rem;font-weight:700;
                     white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
        .carnet-role{font-size:.72rem;font-weight:700;text-transform:uppercase;letter-spacing:.08em;
                     color:var(--accent);margin-top:3px;}
        .carnet-doc{font-size:.78rem;color:var(--text-muted);margin-top:6px;}
        .carnet-sede{font-size:.78rem;color:var(--text-secondary);display:flex;align-items:center;gap:5px;}
        .carnet-fields{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:4px;}
        .field{background:rgba(255,255,255,.04);border:1px solid var(--border);border-radius:10px;padding:10px 12px;}
        .field-label{font-size:.65rem;font-weight:600;text-transform:uppercase;letter-spacing:.06em;color:var(--text-muted);}
        .field-value{font-size:.9rem;font-weight:600;color:var(--text-primary);margin-top:2px;}
        .carnet-stripe{height:3px;background:linear-gradient(90deg,var(--accent),#a855f7,var(--accent));opacity:.5;}
        .saldo-chip{display:inline-flex;align-items:center;gap:6px;background:var(--accent-dim);
                    border:1px solid rgba(124,58,237,.3);border-radius:10px;padding:8px 14px;
                    font-family:'Outfit',sans-serif;font-size:1.3rem;font-weight:800;color:var(--accent);}
        .saldo-label{font-size:.7rem;font-weight:600;text-transform:uppercase;letter-spacing:.06em;
                     color:var(--text-muted);margin-top:2px;}

        /* Info panel */
        .info-row{display:flex;align-items:flex-start;gap:12px;padding:12px 0;border-bottom:1px solid var(--border);}
        .info-row:last-child{border-bottom:none;}
        .info-icon{width:36px;height:36px;border-radius:10px;background:var(--accent-dim);
                   display:flex;align-items:center;justify-content:center;color:var(--accent);
                   font-size:1rem;flex-shrink:0;}
        .info-label{font-size:.75rem;color:var(--text-muted);font-weight:500;}
        .info-value{font-size:.9rem;font-weight:600;margin-top:2px;}

        /* CTA */
        .btn-tienda{display:flex;align-items:center;justify-content:center;gap:10px;
                    background:var(--accent);color:#fff;border:none;border-radius:12px;
                    padding:14px 24px;font-size:1rem;font-weight:700;cursor:pointer;
                    text-decoration:none;transition:background .2s,transform .15s;width:100%;
                    font-family:'Outfit',sans-serif;}
        .btn-tienda:hover{background:var(--accent-dark);transform:translateY(-2px);}
        .btn-salir{display:flex;align-items:center;justify-content:center;gap:8px;
                   color:var(--text-muted);text-decoration:none;font-size:.85rem;
                   padding:10px;border-radius:8px;transition:color .15s;}
        .btn-salir:hover{color:var(--accent-red);}

        @@media(max-width:768px){
            .shell{grid-template-columns:1fr;grid-template-rows:64px auto 1fr;}
            .sidebar{display:none;}
            .dash-grid{grid-template-columns:1fr;}
        }
    </style>
</head>
<body>
<div class="shell">

    <!-- Topbar -->
    <header class="topbar">
        <a href="#" class="topbar-logo">SenaPay</a>
        <div class="topbar-divider"></div>
        <span class="topbar-title">Mi carnet</span>
        <div class="topbar-spacer"></div>
        <button class="btn-theme" onclick="toggleTheme()" title="Cambiar tema">
            <i class="bi bi-circle-half"></i>
        </button>
        <div class="topbar-avatar">@iniciales</div>
    </header>

    <!-- Sidebar -->
    <aside class="sidebar">
        <span class="nav-label">Tienda</span>
        <a href="#" class="nav-item active">
            <i class="bi bi-person-badge-fill"></i> Mi carnet
        </a>
        <a asp-area="Tiendas" asp-controller="Tienda" asp-action="Index" class="nav-item">
            <i class="bi bi-shop-window"></i> Ir a la tienda
        </a>

        <span class="nav-label">Cuenta</span>
        <a asp-area="Funcionarios" asp-controller="SeleccionarModo" asp-action="Index" class="nav-item">
            <i class="bi bi-arrow-left-right"></i> Cambiar modo
        </a>
        <div class="sidebar-bottom">
            <div class="user-chip">
                <div class="chip-avatar">@iniciales</div>
                <div>
                    <div class="chip-name">@Model.Nombre</div>
                    <div class="chip-role">Funcionario</div>
                </div>
            </div>
            <a asp-area="Account" asp-controller="Account" asp-action="Logout"
               class="nav-item" style="color:#ef4444;margin-top:8px;"
               onclick="return confirm('¿Confirmas que deseas cerrar sesión?')">
                <i class="bi bi-box-arrow-left"></i> Cerrar sesión
            </a>
        </div>
    </aside>

    <!-- Main -->
    <main class="main">
        <div class="page-header">
            <h2>Mi Carnet</h2>
            <p>Credencial de acceso a la tienda SenaPay</p>
        </div>

        <div class="dash-grid">
            <!-- Carnet -->
            <div class="carnet-wrap">
                <div class="carnet">
                    <div class="carnet-header">
                        <span class="carnet-logo-text">SenaPay</span>
                        <span class="carnet-header-badge">Funcionario</span>
                    </div>
                    <div class="carnet-stripe"></div>
                    <div class="carnet-body">
                        <div class="carnet-top">
                            <div class="carnet-photo">@iniciales</div>
                            <div class="carnet-info">
                                <div class="carnet-name">@Model.Nombre</div>
                                <div class="carnet-role">Instructor / Funcionario</div>
                                <div class="carnet-doc">
                                    <i class="bi bi-card-text"></i> Doc. @Model.Documento
                                </div>
                                <div class="carnet-sede">
                                    <i class="bi bi-geo-alt-fill"></i> @Model.Sede
                                </div>
                            </div>
                        </div>

                        <div class="carnet-fields">
                            <div class="field">
                                <div class="field-label">Correo</div>
                                <div class="field-value" style="font-size:.78rem;">@Model.Correo</div>
                            </div>
                            @if (!string.IsNullOrEmpty(Model.Telefono))
                            {
                                <div class="field">
                                    <div class="field-label">Teléfono</div>
                                    <div class="field-value">@Model.Telefono</div>
                                </div>
                            }
                        </div>

                        <div>
                            <div class="saldo-label">Saldo disponible</div>
                            <div class="saldo-chip">
                                <i class="bi bi-wallet2"></i>
                                @Model.Saldo.ToString("C0", new System.Globalization.CultureInfo("es-CO"))
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Panel derecho -->
            <div style="display:flex;flex-direction:column;gap:16px;">
                <div class="card">
                    <div class="card-title"><i class="bi bi-info-circle-fill"></i> Información de la cuenta</div>
                    <div class="info-row">
                        <div class="info-icon"><i class="bi bi-person-fill"></i></div>
                        <div>
                            <div class="info-label">Nombre completo</div>
                            <div class="info-value">@Model.Nombre</div>
                        </div>
                    </div>
                    <div class="info-row">
                        <div class="info-icon"><i class="bi bi-envelope-fill"></i></div>
                        <div>
                            <div class="info-label">Correo electrónico</div>
                            <div class="info-value">@Model.Correo</div>
                        </div>
                    </div>
                    <div class="info-row">
                        <div class="info-icon"><i class="bi bi-geo-alt-fill"></i></div>
                        <div>
                            <div class="info-label">Sede</div>
                            <div class="info-value">@Model.Sede</div>
                        </div>
                    </div>
                    <div class="info-row">
                        <div class="info-icon"><i class="bi bi-shield-check-fill"></i></div>
                        <div>
                            <div class="info-label">Tipo de acceso</div>
                            <div class="info-value">Reserva de productos (sin descuento de saldo)</div>
                        </div>
                    </div>
                </div>

                <div class="card">
                    <div class="card-title"><i class="bi bi-shop-window"></i> Acceder a la tienda</div>
                    <p style="font-size:.88rem;color:var(--text-secondary);margin-bottom:16px;line-height:1.5;">
                        Como funcionario puedes explorar el catálogo y hacer reservas de productos.
                        Tu saldo no se descuenta.
                    </p>
                    <a asp-area="Tiendas" asp-controller="Tienda" asp-action="Index"
                       class="btn-tienda">
                        <i class="bi bi-cart3"></i> Entrar a la tienda
                    </a>
                </div>
            </div>
        </div>
    </main>
</div>

<script>
    function toggleTheme() {
        const html = document.documentElement;
        const t = html.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
        html.setAttribute('data-theme', t);
        localStorage.setItem('sp-theme', t);
    }
</script>
</body>
</html>
