@{
    ViewData["Title"] = "Recargar Saldo";
    ViewData["Breadcrumb"] = "Recargas";
    Layout = "~/Areas/AdminCafeteria/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <style>
        .rec-header { margin-bottom: 28px; animation: slideUp .5s cubic-bezier(.22,1,.36,1) both; }
        .rec-title  { font-family: 'Outfit', sans-serif; font-size: 1.35rem; font-weight: 800; color: var(--text-main); }
        .rec-sub    { font-size: .75rem; color: var(--text-muted); margin-top: 2px; }

        .rec-card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 20px;
            padding: 28px;
            max-width: 520px;
            animation: slideUp .6s cubic-bezier(.22,1,.36,1) .06s both;
        }

        .field-label { font-size: .78rem; font-weight: 700; color: var(--text-muted); margin-bottom: 6px; text-transform: uppercase; letter-spacing: .05em; }
        .field-group { margin-bottom: 20px; }

        .scan-row { display: flex; gap: 8px; }
        .scan-input {
            flex: 1;
            background: var(--surface);
            border: 1.5px solid var(--border);
            border-radius: 10px;
            padding: 11px 14px;
            font-size: .92rem;
            color: var(--text-main);
            font-family: 'Courier New', monospace;
            outline: none;
            transition: border-color .2s;
        }
        .scan-input:focus { border-color: var(--c); }

        .btn-buscar {
            background: var(--c);
            color: #fff;
            border: none;
            border-radius: 10px;
            padding: 11px 18px;
            font-weight: 700;
            font-size: .88rem;
            cursor: pointer;
            transition: opacity .2s;
        }
        .btn-buscar:hover { opacity: .85; }

        .aprendiz-card {
            background: var(--surface-alt, rgba(0,0,0,.03));
            border: 1.5px solid var(--border);
            border-radius: 14px;
            padding: 16px 20px;
            margin-bottom: 20px;
            display: none;
            animation: slideUp .3s cubic-bezier(.22,1,.36,1) both;
        }
        .aprendiz-nombre { font-family: 'Outfit', sans-serif; font-size: 1.05rem; font-weight: 800; color: var(--text-main); }
        .aprendiz-saldo  { font-size: .85rem; color: var(--text-muted); margin-top: 4px; }
        .aprendiz-saldo strong { color: var(--c); font-size: 1rem; }

        .monto-input {
            width: 100%;
            background: var(--surface);
            border: 1.5px solid var(--border);
            border-radius: 10px;
            padding: 11px 14px;
            font-size: 1rem;
            color: var(--text-main);
            font-family: 'Outfit', sans-serif;
            font-weight: 700;
            outline: none;
            transition: border-color .2s;
            box-sizing: border-box;
        }
        .monto-input:focus { border-color: var(--c); }

        .btn-recargar {
            width: 100%;
            background: var(--c);
            color: #fff;
            border: none;
            border-radius: 12px;
            padding: 14px;
            font-family: 'Outfit', sans-serif;
            font-size: 1rem;
            font-weight: 800;
            cursor: pointer;
            transition: opacity .2s, transform .15s;
            margin-top: 8px;
        }
        .btn-recargar:hover { opacity: .88; transform: translateY(-1px); }
        .btn-recargar:disabled { opacity: .4; cursor: not-allowed; transform: none; }

        .alert-msg {
            border-radius: 10px;
            padding: 12px 16px;
            font-size: .88rem;
            font-weight: 600;
            margin-top: 16px;
            display: none;
        }
        .alert-ok  { background: rgba(34,197,94,.1); color: #15803d; border: 1px solid rgba(34,197,94,.3); }
        .alert-err { background: rgba(239,68,68,.1); color: #b91c1c; border: 1px solid rgba(239,68,68,.3); }
    </style>
}

<div class="rec-header">
    <div class="rec-title">Recargar Saldo</div>
    <div class="rec-sub">Escanea el carnet o ingresa la cédula del aprendiz</div>
</div>

<div class="rec-card">
    <!-- Paso 1: Buscar aprendiz -->
    <div class="field-group">
        <div class="field-label">Cédula del aprendiz</div>
        <div class="scan-row">
            <input id="inputDoc" class="scan-input" type="number" placeholder="Escanea o escribe la cédula..."
                   autofocus autocomplete="off" />
            <button class="btn-buscar" onclick="buscarAprendiz()">
                <i class="bi bi-search"></i>
            </button>
        </div>
    </div>

    <!-- Resultado de búsqueda -->
    <div class="aprendiz-card" id="aprendizCard">
        <div class="aprendiz-nombre" id="aprendizNombre"></div>
        <div class="aprendiz-saldo">Saldo actual: <strong id="aprendizSaldo"></strong></div>
    </div>

    <!-- Paso 2: Monto -->
    <div class="field-group" id="montoGroup" style="display:none;">
        <div class="field-label">Monto a recargar ($)</div>
        <input id="inputMonto" class="monto-input" type="number" min="1" max="1000000"
               placeholder="Ej: 50000" />
    </div>

    <button id="btnRecargar" class="btn-recargar" onclick="ejecutarRecarga()" disabled>
        <i class="bi bi-wallet2"></i> Recargar
    </button>

    <div id="alertMsg" class="alert-msg"></div>
</div>

@section Scripts {
    <script>
        const inputDoc = document.getElementById('inputDoc');
        const aprendizCard = document.getElementById('aprendizCard');
        const montoGroup = document.getElementById('montoGroup');
        const btnRecargar = document.getElementById('btnRecargar');
        const alertMsg = document.getElementById('alertMsg');

        let documentoActual = null;

        inputDoc.addEventListener('keydown', e => {
            if (e.key === 'Enter') buscarAprendiz();
        });

        async function buscarAprendiz() {
            const doc = parseInt(inputDoc.value);
            if (!doc) return;
            ocultarAlerta();
            aprendizCard.style.display = 'none';
            montoGroup.style.display = 'none';
            btnRecargar.disabled = true;
            documentoActual = null;

            const res = await fetch(`/AdminCafeteria/Recargas/BuscarAprendiz?doc=${doc}`);
            const data = await res.json();

            if (!data.encontrado) {
                mostrarAlerta('No se encontró ningún aprendiz con ese documento.', false);
                return;
            }

            documentoActual = doc;
            document.getElementById('aprendizNombre').textContent = data.nombre;
            document.getElementById('aprendizSaldo').textContent =
                '$' + Math.round(data.saldo).toLocaleString('es-CO');
            aprendizCard.style.display = 'block';
            montoGroup.style.display = 'block';
            btnRecargar.disabled = false;
            document.getElementById('inputMonto').focus();
        }

        async function ejecutarRecarga() {
            if (!documentoActual) return;
            const monto = parseFloat(document.getElementById('inputMonto').value);
            if (!monto || monto <= 0) {
                mostrarAlerta('Ingresa un monto válido.', false);
                return;
            }

            btnRecargar.disabled = true;
            btnRecargar.innerHTML = '<i class="bi bi-hourglass-split"></i> Procesando...';

            const res = await fetch('/AdminCafeteria/Recargas/Ejecutar', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ documento: documentoActual, monto })
            });
            const data = await res.json();

            if (data.ok) {
                mostrarAlerta(data.mensaje, true);
                document.getElementById('aprendizSaldo').textContent =
                    '$' + Math.round(data.nuevoSaldo).toLocaleString('es-CO');
                document.getElementById('inputMonto').value = '';
            } else {
                mostrarAlerta(data.mensaje, false);
            }

            btnRecargar.disabled = false;
            btnRecargar.innerHTML = '<i class="bi bi-wallet2"></i> Recargar';
        }

        function mostrarAlerta(msg, ok) {
            alertMsg.textContent = msg;
            alertMsg.className = 'alert-msg ' + (ok ? 'alert-ok' : 'alert-err');
            alertMsg.style.display = 'block';
        }

        function ocultarAlerta() {
            alertMsg.style.display = 'none';
        }
    </script>
}
