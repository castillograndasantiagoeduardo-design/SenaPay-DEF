@model IEnumerable<SenaPay.Application.DTOs.Tienda.TiendaDto>
@using System.Text.Json
@using SenaPay.Domain.Interfaces
@{
    ViewData["Title"] = "Gestión de Tiendas";
    ViewData["Breadcrumb"] = "Gestión de Tiendas";
    var sedes = ViewBag.Sedes as List<SenaPay.Application.DTOs.Tienda.SedeDto> ?? new();
    var admins = ViewBag.Admins as List<AdminCafeteriaListItem> ?? new();
}

@* ── ESTADÍSTICAS ── *@
<div class="stats-row">
    <div class="stat-card">
        <div class="stat-icon" style="background:rgba(232,108,0,.1);color:#E86C00;">
            <i class="bi bi-shop"></i>
        </div>
        <div class="stat-value">@Model.Count()</div>
        <div class="stat-label">Tiendas</div>
        <div class="stat-delta delta-up"><i class="bi bi-arrow-up-short"></i> Habilitadas</div>
    </div>
</div>

@* ── ENCABEZADO DE SECCIÓN ── *@
<div class="section-header" style="justify-content:space-between;align-items:center;">
    <div style="display:flex;align-items:center;gap:12px;">
        <div class="section-icon"><i class="bi bi-shop-fill"></i></div>
        <div>
            <div class="section-title">Gestión de Tiendas</div>
            <div class="section-sub">Crea y administra las tiendas del ecosistema SenaPay</div>
        </div>
    </div>
    <button class="btn-primary" onclick="abrirModalCrear()">
        <div class="btn-icon-box"><i class="bi bi-plus-circle-fill"></i></div>
        <span>Nueva Tienda</span>
    </button>
</div>

@* ── TABLA ── *@
<div class="card">
    <div class="table-wrap">
        <table class="sp-table">
            <thead>
                <tr>
                    <th>Tienda</th>
                    <th>Sede</th>
                    <th>Ubicación</th>
                    <th>Administrador</th>
                    <th style="text-align:center;">Acción</th>  <!-- NUEVO -->
                </tr>
            </thead>
            <tbody id="tbodyTiendas">
                @if (!Model.Any())
                {
                    <tr id="emptyRow">
                        <td colspan="4" style="text-align:center;padding:40px;color:var(--text-muted);">
                            <i class="bi bi-shop" style="font-size:1.6rem;display:block;margin-bottom:10px;opacity:.4;"></i>
                            Aún no hay tiendas registradas
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var t in Model)
                    {
                        <tr>
                            <td style="font-weight:600;">
                                <span class="badge-tienda"><i class="bi bi-shop"></i> @t.NombreTienda</span>
                            </td>
                            <td>@t.NombreSede</td>
                            <td style="color:var(--text-muted);">@t.Ubicacion</td>
                            <td>
                                @if (!string.IsNullOrEmpty(t.NombreAdmin))
                                {
                                    <span class="badge-admin-asignado">
                                        <i class="bi bi-person-check-fill"></i> @t.NombreAdmin
                                    </span>
                                }
                                else
                                {
                                    <span class="badge-sin-admin">
                                        <i class="bi bi-person-dash"></i> Sin asignar
                                    </span>
                                }
                            </td>
                            <td style="text-align:center;">
                                <!-- NUEVO -->
                                <button class="btn-asignar"
                                        onclick="abrirModalAsignar(@t.IdTienda, '@Html.Raw(t.NombreTienda)', @(t.IdAdminCafeteria.HasValue ? t.IdAdminCafeteria.Value.ToString() : "null"))">
                                    <i class="bi bi-person-gear"></i>
                                    @(string.IsNullOrEmpty(t.NombreAdmin) ? "Asignar" : "Cambiar")
                                </button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@* ── MODAL NUEVA TIENDA ── *@
<div id="modalTienda" class="modal-backdrop" onclick="cerrarSiBackdrop(event)">
    <div class="modal-box" role="dialog" aria-modal="true">

        <div class="modal-header">
            <div style="display:flex;align-items:center;gap:10px;">
                <div class="modal-icon"><i class="bi bi-shop-window"></i></div>
                <div>
                    <div class="modal-title">Nueva Tienda</div>
                    <div class="modal-sub">Completa los datos de la tienda y su administrador</div>
                </div>
            </div>
            <button class="modal-close" onclick="cerrarModal()" aria-label="Cerrar">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>

        <div class="modal-body">
            @Html.AntiForgeryToken()
            <div class="form-grid">

                @* ── Datos de la tienda ── *@
                <div class="section-group-label">
                    <i class="bi bi-shop"></i> Datos de la Tienda
                </div>

                <div class="field-group full">
                    <label class="field-label">Nombre de la Tienda</label>
                    <div class="field-wrap">
                        <i class="bi bi-shop field-icon"></i>
                        <input type="text" class="form-control" id="t-nombre"
                               placeholder="Ej. Cafetería Central" autocomplete="off" />
                    </div>
                </div>

                <div class="field-group">
                    <label class="field-label">Sede SENA</label>
                    <div class="field-wrap">
                        <i class="bi bi-building field-icon"></i>
                        <select class="form-select" id="t-sede">
                            <option value="">— Selecciona una sede —</option>
                            @foreach (var sede in sedes)
                            {
                                <option value="@sede.IdSede">@sede.Nombre — @sede.Ciudad</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="field-group">
                    <label class="field-label">Ubicación</label>
                    <div class="field-wrap">
                        <i class="bi bi-geo-alt field-icon"></i>
                        <input type="text" class="form-control" id="t-ubicacion"
                               placeholder="Ej. Bloque A, Piso 1" autocomplete="off" />
                    </div>
                </div>

                <hr class="form-divider" />

                @* ── Administrador — header con toggle ── *@
                <div class="section-group-label" style="display:flex;justify-content:space-between;align-items:center;">
                    <span><i class="bi bi-person-badge"></i> Administrador de la Tienda</span>
                    <div class="modo-toggle">
                        <button type="button" id="btnModoNuevo"
                                class="modo-btn active" onclick="setModo('Nuevo')">
                            <i class="bi bi-person-plus"></i> Crear nuevo
                        </button>
                        <button type="button" id="btnModoExistente"
                                class="modo-btn" onclick="setModo('Existente')">
                            <i class="bi bi-people"></i> Seleccionar existente
                        </button>
                    </div>
                </div>

                @* ── Panel: Crear nuevo ── *@
                <div id="panelNuevo" class="field-group full">
                    <div class="form-grid" style="padding:0;">

                        <div class="field-group">
                            <label class="field-label">Nombre completo</label>
                            <div class="field-wrap">
                                <i class="bi bi-person field-icon"></i>
                                <input type="text" class="form-control" id="a-nombre"
                                       placeholder="Nombre del administrador" autocomplete="off" />
                            </div>
                        </div>

                        <div class="field-group">
                            <label class="field-label">Documento</label>
                            <div class="field-wrap">
                                <i class="bi bi-hash field-icon"></i>
                                <input type="text" class="form-control" id="a-documento"
                                       placeholder="0000000000" maxlength="12"
                                       onkeypress="return soloNumeros(event)" />
                            </div>
                        </div>

                        <div class="field-group">
                            <label class="field-label">Correo electrónico</label>
                            <div class="field-wrap">
                                <i class="bi bi-envelope field-icon"></i>
                                <input type="email" class="form-control" id="a-correo"
                                       placeholder="admin@sena.edu.co" autocomplete="off" />
                            </div>
                        </div>

                        <div class="field-group">
                            <label class="field-label">Teléfono</label>
                            <div class="field-wrap">
                                <i class="bi bi-telephone field-icon"></i>
                                <input type="text" class="form-control" id="a-telefono"
                                       placeholder="300 000 0000" maxlength="10"
                                       onkeypress="return soloNumeros(event)" />
                            </div>
                        </div>

                    </div>
                </div>

                @* ── Panel: Seleccionar existente ── *@
                <div id="panelExistente" class="field-group full" style="display:none;">

                    <label class="field-label">Selecciona un administrador</label>
                    <div class="field-wrap">
                        <i class="bi bi-people field-icon"></i>
                        <select class="form-select" id="a-existente" onchange="mostrarPreview()">
                            <option value="">— Selecciona un administrador —</option>
                            @foreach (var a in admins)
                            {
                                var badge = a.TiendasAsignadas == 0
                                ? "Sin tiendas"
                                : $"{a.TiendasAsignadas} tienda(s)";
                                <option value="@a.IdAdminCafeteria"
                                        data-nombre="@a.Nombre"
                                        data-correo="@a.Correo"
                                        data-telefono="@a.Telefono"
                                        data-tiendas="@badge">
                                    @a.Nombre — @badge
                                </option>
                            }
                        </select>
                    </div>

                    @* Preview del admin seleccionado *@
                    <div id="adminPreview" class="admin-preview" style="display:none;">
                        <div class="preview-avatar"><i class="bi bi-person-fill"></i></div>
                        <div class="preview-info">
                            <div class="preview-nombre" id="pv-nombre"></div>
                            <div class="preview-detalle" id="pv-correo"></div>
                            <div class="preview-detalle" id="pv-telefono"></div>
                            <div class="preview-badge" id="pv-tiendas"></div>
                        </div>
                    </div>

                </div>
            </div>
        </div>

        <div class="modal-footer">
            <button class="btn-modal-cancel" onclick="cerrarModal()">Cancelar</button>
            <button class="btn-modal-save" id="btnGuardar" onclick="submitCrearTienda()">
                <div class="spinner" id="spinner"></div>
                <span id="textoBtn">Crear Tienda</span>
                <div class="btn-icon-box"><i class="bi bi-shop-window"></i></div>
            </button>
        </div>

    </div>
</div>

@* ── MODAL ASIGNAR ADMIN ── *@
<div id="modalAsignar" class="modal-backdrop" onclick="cerrarSiBackdropAsignar(event)">
    <div class="modal-box" style="max-width:480px;" role="dialog" aria-modal="true">

        <div class="modal-header">
            <div style="display:flex;align-items:center;gap:10px;">
                <div class="modal-icon"><i class="bi bi-person-gear"></i></div>
                <div>
                    <div class="modal-title">Asignar Administrador</div>
                    <div class="modal-sub" id="asignar-sub">Tienda seleccionada</div>
                </div>
            </div>
            <button class="modal-close" onclick="cerrarModalAsignar()" aria-label="Cerrar">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>

        <div class="modal-body">
            @Html.AntiForgeryToken()

            <div class="field-group full">
                <label class="field-label">Administrador de Cafetería</label>
                <div class="field-wrap">
                    <i class="bi bi-people field-icon"></i>
                    <select class="form-select" id="as-admin" onchange="mostrarPreviewAsignar()">
                        <option value="">— Sin administrador (desasignar) —</option>
                        @foreach (var a in admins)
                        {
                            var badge = a.TiendasAsignadas == 0
                            ? "Sin tiendas"
                            : $"{a.TiendasAsignadas} tienda(s)";
                            <option value="@a.IdAdminCafeteria"
                                    data-nombre="@a.Nombre"
                                    data-correo="@a.Correo"
                                    data-telefono="@a.Telefono"
                                    data-tiendas="@badge">
                                @a.Nombre — @badge
                            </option>
                        }
                    </select>
                </div>
            </div>

            @* Preview *@
            <div id="asignarPreview" class="admin-preview" style="display:none;margin-top:14px;">
                <div class="preview-avatar"><i class="bi bi-person-fill"></i></div>
                <div class="preview-info">
                    <div class="preview-nombre" id="as-pv-nombre"></div>
                    <div class="preview-detalle" id="as-pv-correo"></div>
                    <div class="preview-detalle" id="as-pv-telefono"></div>
                    <div class="preview-badge" id="as-pv-tiendas"></div>
                </div>
            </div>

            @* Aviso desasignar *@
            <div id="avisoDesasignar" class="aviso-warning" style="display:none;margin-top:14px;">
                <i class="bi bi-exclamation-triangle-fill"></i>
                La tienda quedará <strong>sin administrador asignado</strong>.
            </div>

        </div>

        <div class="modal-footer">
            <button class="btn-modal-cancel" onclick="cerrarModalAsignar()">Cancelar</button>
            <button class="btn-modal-save" id="btnGuardarAsignar" onclick="submitAsignarAdmin()">
                <div class="spinner" id="spinnerAsignar"></div>
                <span id="textoBtnAsignar">Guardar</span>
                <div class="btn-icon-box"><i class="bi bi-person-check-fill"></i></div>
            </button>
        </div>

    </div>
</div>

@section Styles {
    <style>
        /* ── Badges ── */
        .badge-tienda {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 4px 10px;
            border-radius: 99px;
            font-size: .65rem;
            font-weight: 700;
            font-family: 'Outfit',sans-serif;
            background: rgba(109,40,217,.1);
            color: #6D28D9;
        }

        .section-group-label {
            grid-column: 1/-1;
            font-family: 'Outfit',sans-serif;
            font-size: .7rem;
            font-weight: 800;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 1.4px;
            padding-bottom: 4px;
            border-bottom: 1px solid var(--border);
        }

        /* ── Toggle modo ── */
        .modo-toggle {
            display: flex;
            gap: 4px;
            background: rgba(255,255,255,.04);
            border: 1px solid rgba(255,255,255,.08);
            border-radius: 10px;
            padding: 3px;
        }

        .modo-btn {
            padding: 5px 12px;
            border-radius: 7px;
            border: none;
            background: transparent;
            color: var(--text-muted);
            font-family: 'Outfit',sans-serif;
            font-size: .72rem;
            font-weight: 600;
            cursor: pointer;
            transition: background .2s,color .2s;
            display: inline-flex;
            align-items: center;
            gap: 5px;
        }

            .modo-btn.active {
                background: var(--c);
                color: #fff;
                box-shadow: 0 2px 8px var(--cg);
            }

        /* ── Preview admin ── */
        .admin-preview {
            margin-top: 12px;
            display: flex;
            align-items: center;
            gap: 12px;
            background: rgba(109,40,217,.07);
            border: 1px solid rgba(109,40,217,.18);
            border-radius: 12px;
            padding: 12px 16px;
        }

        .preview-avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: rgba(109,40,217,.15);
            color: #6D28D9;
            display: grid;
            place-items: center;
            font-size: 18px;
            flex-shrink: 0;
        }

        .preview-nombre {
            font-weight: 700;
            font-size: .85rem;
            color: var(--text-main);
        }

        .preview-detalle {
            font-size: .75rem;
            color: var(--text-muted);
        }

        .preview-badge {
            display: inline-block;
            margin-top: 4px;
            font-size: .65rem;
            font-weight: 700;
            background: rgba(109,40,217,.12);
            color: #6D28D9;
            border-radius: 99px;
            padding: 2px 9px;
        }

        /* ── Modal ── */
        .modal-backdrop {
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,.65);
            backdrop-filter: blur(4px);
            z-index: 1000;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
            opacity: 0;
            pointer-events: none;
            transition: opacity .25s ease;
        }

            .modal-backdrop.open {
                opacity: 1;
                pointer-events: auto;
            }

        .modal-box {
            background: #13131f;
            border: 1px solid rgba(255,255,255,.07);
            border-radius: 20px;
            width: 100%;
            max-width: 620px;
            max-height: 90vh;
            overflow-y: auto;
            box-shadow: 0 32px 80px rgba(0,0,0,.5);
            transform: translateY(16px) scale(.98);
            transition: transform .3s cubic-bezier(.22,1,.36,1),opacity .25s;
            opacity: 0;
        }

        .modal-backdrop.open .modal-box {
            transform: translateY(0) scale(1);
            opacity: 1;
        }

        .modal-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 22px 24px 18px;
            border-bottom: 1px solid rgba(255,255,255,.06);
        }

        .modal-icon {
            width: 38px;
            height: 38px;
            border-radius: 11px;
            background: rgba(109,40,217,.12);
            display: grid;
            place-items: center;
            color: var(--c);
            font-size: 16px;
        }

        .modal-title {
            font-family: 'Outfit',sans-serif;
            font-size: .95rem;
            font-weight: 700;
            color: #f0f0ff;
        }

        .modal-sub {
            font-size: .72rem;
            color: #6b7a99;
            margin-top: 2px;
        }

        .modal-close {
            width: 32px;
            height: 32px;
            border-radius: 8px;
            border: 1px solid rgba(255,255,255,.08);
            background: transparent;
            color: #6b7a99;
            cursor: pointer;
            display: grid;
            place-items: center;
            font-size: 14px;
            transition: background .2s,color .2s;
        }

            .modal-close:hover {
                background: rgba(239,68,68,.12);
                color: #ef4444;
            }

        .modal-body {
            padding: 22px 24px;
        }

        .modal-footer {
            display: flex;
            align-items: center;
            justify-content: flex-end;
            gap: 10px;
            padding: 16px 24px 22px;
            border-top: 1px solid rgba(255,255,255,.06);
        }

        .modal-box .form-control,
        .modal-box .form-select {
            background: #1c1c2e !important;
            border-color: rgba(255,255,255,.1) !important;
            color: #e2e8f0 !important;
        }

            .modal-box .form-control:focus,
            .modal-box .form-select:focus {
                border-color: #6D28D9 !important;
                box-shadow: 0 0 0 3px rgba(109,40,217,.2) !important;
            }

            .modal-box .form-control::placeholder {
                color: #4a5578;
            }

        .modal-box .field-label {
            color: #4a5578;
        }

        .modal-box .field-icon {
            color: #4a5578;
        }

        .modal-box .form-divider {
            border-color: rgba(255,255,255,.06);
        }

        .btn-modal-cancel {
            padding: 11px 20px;
            border: 1px solid var(--border);
            border-radius: 11px;
            background: transparent;
            color: var(--text-muted);
            font-family: 'Outfit',sans-serif;
            font-size: .8rem;
            font-weight: 600;
            cursor: pointer;
        }

            .btn-modal-cancel:hover {
                background: rgba(100,116,139,.08);
                color: var(--text-main);
            }

        .btn-modal-save {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            padding: 11px 22px;
            border: none;
            border-radius: 11px;
            background: var(--c);
            color: #fff;
            font-family: 'Outfit',sans-serif;
            font-size: .8rem;
            font-weight: 700;
            letter-spacing: 1px;
            cursor: pointer;
            box-shadow: 0 6px 20px var(--cg);
            transition: background .2s,transform .15s;
        }

            .btn-modal-save:hover:not(:disabled) {
                background: var(--cd);
                transform: translateY(-1px);
            }

            .btn-modal-save:disabled {
                opacity: .55;
                cursor: not-allowed;
            }

        .spinner {
            display: none;
            width: 14px;
            height: 14px;
            border: 2px solid rgba(255,255,255,.3);
            border-top-color: #fff;
            border-radius: 50%;
            animation: spin .7s linear infinite;
        }

        @@keyframes spin {
            to {
                transform: rotate(360deg);
            }
        }

        /* ── Badges admin en tabla ── */
        .badge-admin-asignado {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 3px 10px;
            border-radius: 99px;
            font-size: .68rem;
            font-weight: 700;
            background: rgba(34,197,94,.1);
            color: #22c55e;
        }

        .badge-sin-admin {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 3px 10px;
            border-radius: 99px;
            font-size: .68rem;
            font-weight: 700;
            background: rgba(100,116,139,.1);
            color: #64748b;
        }

        /* ── Botón asignar en fila ── */
        .btn-asignar {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 6px 14px;
            border: 1px solid rgba(109,40,217,.3);
            border-radius: 8px;
            background: rgba(109,40,217,.07);
            color: #a78bfa;
            font-family: 'Outfit', sans-serif;
            font-size: .72rem;
            font-weight: 600;
            cursor: pointer;
            transition: background .2s, border-color .2s, color .2s;
        }

            .btn-asignar:hover {
                background: rgba(109,40,217,.18);
                border-color: rgba(109,40,217,.55);
                color: #c4b5fd;
            }

        /* ── Aviso desasignar ── */
        .aviso-warning {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 12px 16px;
            border-radius: 10px;
            background: rgba(245,158,11,.08);
            border: 1px solid rgba(245,158,11,.25);
            color: #f59e0b;
            font-size: .78rem;
        }
    </style>
}

@section Scripts {
    <script>
        // ── Estado ────────────────────────────────────────────────────────────
        let modoAdmin = 'Nuevo'; // coincide con el enum en C#

        function soloNumeros(e) {
            const c = e.which || e.keyCode;
            return c >= 48 && c <= 57;
        }
        function getToken() {
            return document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';
        }

        // ── Toggle Nuevo / Existente ──────────────────────────────────────────
        function setModo(modo) {
            modoAdmin = modo;
            document.getElementById('panelNuevo').style.display     = modo === 'Nuevo'     ? '' : 'none';
            document.getElementById('panelExistente').style.display = modo === 'Existente' ? '' : 'none';
            document.getElementById('btnModoNuevo').classList.toggle('active',     modo === 'Nuevo');
            document.getElementById('btnModoExistente').classList.toggle('active', modo === 'Existente');
            ocultarPreview();
        }

        // ── Preview admin existente ───────────────────────────────────────────
        function mostrarPreview() {
            const sel = document.getElementById('a-existente');
            const opt = sel.options[sel.selectedIndex];
            const pv  = document.getElementById('adminPreview');

            if (!sel.value) { ocultarPreview(); return; }

            document.getElementById('pv-nombre').textContent   = opt.dataset.nombre   ?? '';
            document.getElementById('pv-correo').textContent   = opt.dataset.correo   ?? '';
            document.getElementById('pv-telefono').textContent = opt.dataset.telefono ?? '';
            document.getElementById('pv-tiendas').textContent  = opt.dataset.tiendas  ?? '';
            pv.style.display = 'flex';
        }
        function ocultarPreview() {
            document.getElementById('adminPreview').style.display = 'none';
        }

        // ── Modal ─────────────────────────────────────────────────────────────
        function abrirModalCrear() {
            limpiarModal();
            document.getElementById('modalTienda').classList.add('open');
            document.body.style.overflow = 'hidden';
        }
        function cerrarModal() {
            document.getElementById('modalTienda').classList.remove('open');
            document.body.style.overflow = '';
        }
        function cerrarSiBackdrop(e) {
            if (e.target === document.getElementById('modalTienda')) cerrarModal();
        }
        function limpiarModal() {
            ['t-nombre','t-ubicacion','a-nombre','a-correo','a-telefono','a-documento']
                .forEach(id => { document.getElementById(id).value = ''; });
            document.getElementById('t-sede').value      = '';
            document.getElementById('a-existente').value = '';
            ocultarPreview();
            setModo('Nuevo'); // reset al modo por defecto
        }

        // ── Submit ────────────────────────────────────────────────────────────
        async function submitCrearTienda() {
            const payload = {
                nombreTienda : document.getElementById('t-nombre').value.trim(),
                ubicacion    : document.getElementById('t-ubicacion').value.trim(),
                idSede       : parseInt(document.getElementById('t-sede').value) || 0,
                modoAdmin    : modoAdmin, // 'Nuevo' | 'Existente' → JsonStringEnumConverter

                // Modo Existente
                idAdminExistente : modoAdmin === 'Existente'
                    ? parseInt(document.getElementById('a-existente').value) || null
                    : null,

                // Modo Nuevo
                nombreAdmin   : modoAdmin === 'Nuevo' ? document.getElementById('a-nombre').value.trim()    : null,
                correoAdmin   : modoAdmin === 'Nuevo' ? document.getElementById('a-correo').value.trim()    : null,
                telefonoAdmin : modoAdmin === 'Nuevo' ? document.getElementById('a-telefono').value.trim()  : null,
                documentoAdmin: modoAdmin === 'Nuevo' ? parseInt(document.getElementById('a-documento').value) || null : null
            };

            // Validación cliente
            if (!payload.nombreTienda)
                return showToast('error', 'Campo requerido', 'Ingresa el nombre de la tienda.');
            if (!payload.idSede)
                return showToast('error', 'Campo requerido', 'Selecciona una sede.');
            if (!payload.ubicacion)
                return showToast('error', 'Campo requerido', 'Ingresa la ubicación.');

            if (modoAdmin === 'Existente' && !payload.idAdminExistente)
                return showToast('error', 'Campo requerido', 'Selecciona un administrador existente.');

            if (modoAdmin === 'Nuevo') {
                if (!payload.nombreAdmin || !payload.correoAdmin || !payload.documentoAdmin)
                    return showToast('error', 'Campos incompletos', 'Completa nombre, correo y documento del administrador.');
            }

            // UI: loading
            const btn     = document.getElementById('btnGuardar');
            const spinner = document.getElementById('spinner');
            const texto   = document.getElementById('textoBtn');
            btn.disabled          = true;
            spinner.style.display = 'block';
            texto.textContent     = 'Guardando...';

            try {
                const res  = await fetch('/Funcionarios/Tiendas/Crear', {
                    method : 'POST',
                    headers: {
                        'Content-Type'            : 'application/json',
                        'RequestVerificationToken': getToken()
                    },
                    body: JSON.stringify(payload)
                });
                const data = await res.json();

                if (data.ok) {
                    cerrarModal();
                    showToast('success', '¡Tienda creada!', data.msg);
                    await cargarTiendas();
                } else {
                    showToast('error', 'Error', data.msg);
                }
            } catch {
                showToast('error', 'Error de conexión', 'Intenta de nuevo.');
            } finally {
                btn.disabled          = false;
                spinner.style.display = 'none';
                texto.textContent     = 'Crear Tienda';
            }
        }

        // ── Recarga la tabla sin recargar la página ───────────────────────────
                async function cargarTiendas() {
            try {
                const res     = await fetch('/Funcionarios/Tiendas/ObtenerTiendas');
                const tiendas = await res.json();
                const tbody   = document.getElementById('tbodyTiendas');

                tbody.innerHTML = tiendas.length === 0
                    ? `<tr><td colspan="5" style="text-align:center;padding:40px;color:var(--text-muted);">
                         <i class="bi bi-shop" style="font-size:1.6rem;display:block;margin-bottom:10px;opacity:.4;"></i>
                         Aún no hay tiendas registradas
                       </td></tr>`
                    : tiendas.map(t => `
                        <tr>
                          <td style="font-weight:600;">
                            <span class="badge-tienda"><i class="bi bi-shop"></i> ${esc(t.nombreTienda)}</span>
                          </td>
                          <td>${esc(t.nombreSede)}</td>
                          <td style="color:var(--text-muted);">${esc(t.ubicacion)}</td>
                          <td>
                            ${t.nombreAdmin
                              ? `<span class="badge-admin-asignado"><i class="bi bi-person-check-fill"></i> ${esc(t.nombreAdmin)}</span>`
                              : `<span class="badge-sin-admin"><i class="bi bi-person-dash"></i> Sin asignar</span>`}
                          </td>
                          <td style="text-align:center;">
                            <button class="btn-asignar"
                                    onclick="abrirModalAsignar(${t.idTienda}, '${esc(t.nombreTienda)}', ${t.idAdminCafeteria ?? 'null'})">
                              <i class="bi bi-person-gear"></i>
                              ${t.nombreAdmin ? 'Cambiar' : 'Asignar'}
                            </button>
                          </td>
                        </tr>`).join('');
            } catch(err) {
                console.warn('Error al cargar tiendas:', err);
            }
        }

        function esc(str) {
            return String(str ?? '')
                .replace(/&/g,'&amp;').replace(/</g,'&lt;')
                .replace(/>/g,'&gt;').replace(/"/g,'&quot;');
        }

        document.addEventListener('keydown', e => { if (e.key === 'Escape') cerrarModal(); });

                // ── Estado modal asignar ─────────────────────────────────────────────
        let _idTiendaSeleccionada = null;

        function abrirModalAsignar(idTienda, nombreTienda, idAdminActual) {
            _idTiendaSeleccionada = idTienda;

            document.getElementById('asignar-sub').textContent =
                `Tienda: ${nombreTienda}`;

            // Pre-seleccionar admin actual si lo tiene
            const sel = document.getElementById('as-admin');
            sel.value = idAdminActual ?? '';
            mostrarPreviewAsignar();

            document.getElementById('modalAsignar').classList.add('open');
            document.body.style.overflow = 'hidden';
        }

        function cerrarModalAsignar() {
            document.getElementById('modalAsignar').classList.remove('open');
            document.body.style.overflow = '';
            _idTiendaSeleccionada = null;
            document.getElementById('asignarPreview').style.display  = 'none';
            document.getElementById('avisoDesasignar').style.display = 'none';
        }

        function cerrarSiBackdropAsignar(e) {
            if (e.target === document.getElementById('modalAsignar'))
                cerrarModalAsignar();
        }

        function mostrarPreviewAsignar() {
            const sel     = document.getElementById('as-admin');
            const preview = document.getElementById('asignarPreview');
            const aviso   = document.getElementById('avisoDesasignar');

            if (!sel.value) {
                // Opción "Sin administrador"
                preview.style.display = 'none';
                aviso.style.display   = 'flex';
                return;
            }

            aviso.style.display = 'none';
            const opt = sel.options[sel.selectedIndex];
            document.getElementById('as-pv-nombre').textContent   = opt.dataset.nombre   ?? '';
            document.getElementById('as-pv-correo').textContent   = opt.dataset.correo   ?? '';
            document.getElementById('as-pv-telefono').textContent = opt.dataset.telefono ?? '';
            document.getElementById('as-pv-tiendas').textContent  = opt.dataset.tiendas  ?? '';
            preview.style.display = 'flex';
        }

        async function submitAsignarAdmin() {
            if (!_idTiendaSeleccionada) return;

            const idAdmin = document.getElementById('as-admin').value;

            const payload = {
                idTienda         : _idTiendaSeleccionada,
                idAdminCafeteria : idAdmin ? parseInt(idAdmin) : null
            };

            const btn     = document.getElementById('btnGuardarAsignar');
            const spinner = document.getElementById('spinnerAsignar');
            const texto   = document.getElementById('textoBtnAsignar');
            btn.disabled          = true;
            spinner.style.display = 'block';
            texto.textContent     = 'Guardando...';

            try {
                const res  = await fetch('/Funcionarios/Tiendas/AsignarAdmin', {
                    method : 'POST',
                    headers: {
                        'Content-Type'            : 'application/json',
                        'RequestVerificationToken': getToken()
                    },
                    body: JSON.stringify(payload)
                });
                const data = await res.json();

                if (data.ok) {
                    cerrarModalAsignar();
                    showToast('success', '¡Listo!', data.msg);
                    await cargarTiendas(); // recarga la tabla sin recargar la página
                } else {
                    showToast('error', 'Error', data.msg);
                }
            } catch {
                showToast('error', 'Error de conexión', 'Intenta de nuevo.');
            } finally {
                btn.disabled          = false;
                spinner.style.display = 'none';
                texto.textContent     = 'Guardar';
            }
        }

        document.addEventListener('keydown', e => {
            if (e.key === 'Escape') {
                cerrarModal();
                cerrarModalAsignar();
            }
        });
    </script>
}